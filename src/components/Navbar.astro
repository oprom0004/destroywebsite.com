---
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Play', href: '/' },
  { name: 'Targets', href: '/targets/' },
  { name: 'Weapons', href: '/weapons/' },
  { name: 'How to play', href: '/how-to-play/' },
  { name: 'Bookmarklet', href: '/bookmarklet/' },
  { name: 'About', href: '/what-is-destroy-website/' },
];
---

<header class="sticky top-0 z-50 bg-arcade-darkest/90 backdrop-blur-md border-b border-arcade-border">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-neon-pink to-neon-purple p-0.5 shadow-[0_0_15px_rgba(255,42,109,0.4)] group-hover:shadow-[0_0_25px_rgba(255,42,109,0.7)] transition-all">
        <div class="w-full h-full bg-arcade-darkest rounded-[7px] flex items-center justify-center text-lg">
          💥
        </div>
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-black text-base tracking-wide text-white group-hover:text-neon-pink transition-colors">
            DESTROY<span class="text-neon-cyan">WEBSITE</span>
          </span>
          <span class="px-1.5 py-0.5 text-[10px] font-mono font-bold bg-neon-pink/20 text-neon-pink border border-neon-pink/40 rounded">
            ARCADE
          </span>
        </div>
        <p class="text-[10px] text-destruct-dim font-mono tracking-tight -mt-0.5">
          A little chaos. A lot of fun.
        </p>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-2 whitespace-nowrap">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all ${
              isActive
                ? 'bg-neon-pink/15 text-neon-pink border border-neon-pink/30'
                : 'text-destruct-muted hover:text-white hover:bg-arcade-hover'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Quick Action -->
    <div class="hidden sm:flex items-center gap-2">
      <a
        href="/#game-viewport"
        class="px-3.5 py-1.5 text-xs font-black bg-gradient-to-r from-neon-pink to-neon-purple hover:from-neon-pink hover:to-neon-pink text-white rounded-lg shadow-[0_0_15px_rgba(255,42,109,0.3)] hover:shadow-[0_0_20px_rgba(255,42,109,0.6)] transition-all flex items-center gap-1"
      >
        <span>Start playing</span>
        <span class="text-xs">⚡</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-destruct-muted hover:text-white rounded-lg border border-arcade-border"
      aria-label="Toggle Navigation"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-arcade-darkest border-b border-arcade-border px-4 py-3 space-y-1">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 text-xs font-semibold text-destruct-muted hover:text-neon-pink hover:bg-arcade-hover rounded-lg"
      >
        {link.name}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
