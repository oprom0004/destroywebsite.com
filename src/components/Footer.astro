---
const currentYear = new Date().getFullYear();
---

<footer class="bg-arcade-darkest border-t border-arcade-border mt-16 text-xs text-destruct-muted">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand -->
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">💥</span>
          <span class="font-black text-white text-base tracking-wider">
            DESTROY<span class="text-neon-cyan">WEBSITE</span>
          </span>
        </div>
        <p class="text-destruct-dim text-xs leading-relaxed">
          The ultimate 2D physics web demolition playground and stress-relief sandbox. Type any URL or choose a preset to smash, laser, and vaporize web pages safely in your browser.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-2">
        <h4 class="font-bold text-white uppercase tracking-wider text-[11px] font-mono">Game Modes</h4>
        <ul class="space-y-1.5">
          <li><a href="/" class="hover:text-neon-pink transition-colors">🎮 Web Demolition Sandbox</a></li>
          <li><a href="/targets/" class="hover:text-neon-pink transition-colors">🎯 Preset Target Sites</a></li>
          <li><a href="/weapons/" class="hover:text-neon-pink transition-colors">💣 Weapon Armory & Stats</a></li>
          <li><a href="/bookmarklet/" class="hover:text-neon-pink transition-colors">⚡ Browser Bookmarklet</a></li>
        </ul>
      </div>

      <!-- Col 3: Guides & Knowledge -->
      <div class="space-y-2">
        <h4 class="font-bold text-white uppercase tracking-wider text-[11px] font-mono">Guides & FAQ</h4>
        <ul class="space-y-1.5">
          <li><a href="/what-is-destroy-website/" class="hover:text-neon-pink transition-colors">ℹ️ What is Destroy Website?</a></li>
          <li><a href="/how-to-play/" class="hover:text-neon-pink transition-colors">📜 Controls & How to Play</a></li>
          <li><a href="/updates/" class="hover:text-neon-pink transition-colors">🚀 Version Release Notes</a></li>
          <li><a href="/about/" class="hover:text-neon-pink transition-colors">🛡️ About & Fair Use</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Disclaimer -->
      <div class="space-y-2">
        <h4 class="font-bold text-white uppercase tracking-wider text-[11px] font-mono">Safety & Legal</h4>
        <p class="text-[11px] text-destruct-dim leading-relaxed">
          <strong>Safe & Harmless Disclaimer:</strong> Destroy Website is an entertainment simulation operating 100% inside your local browser. No live servers, databases, or third-party websites are harmed or altered.
        </p>
        <div class="flex gap-3 pt-2 text-[11px]">
          <a href="/privacy/" class="hover:text-neon-cyan transition-colors underline">Privacy Policy</a>
          <a href="/terms/" class="hover:text-neon-cyan transition-colors underline">Terms of Service</a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-arcade-border/50 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-destruct-dim font-mono">
      <p>© {currentYear} destroywebsite.com. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-neon-green animate-pulse"></span>
        Physics Engine Online · Zero Server Impact
      </p>
    </div>
  </div>
</footer>
