  // Dynamic Organic Blast Shapes with Pixel Dithering Border
  function punchBlastHole(x: number, y: number, baseRadius: number, shape: 'small' | 'jagged' | 'star' | 'pellet' | 'huge' = 'jagged') {
    if (!pageCtx || !pageCanvas) return;

    // 1. Pixel Dithering Dark Shadow Rim around edge
    pageCtx.fillStyle = 'rgba(30, 41, 59, 0.4)';
    const shadowR = baseRadius + 2;
    for (let angle = 0; angle < Math.PI * 2; angle += 0.3) {
      if (Math.random() > 0.15) {
        const px = x + Math.cos(angle) * (shadowR + (Math.random() - 0.5) * 2);
        const py = y + Math.sin(angle) * (shadowR + (Math.random() - 0.5) * 2);
        pageCtx.fillRect(Math.round(px), Math.round(py), 3, 3);
      }
    }

    // 2. Punch the transparent cutout
    pageCtx.globalCompositeOperation = 'destination-out';
    pageCtx.beginPath();

    if (shape === 'small') {
      pageCtx.arc(x, y, baseRadius, 0, Math.PI * 2);
    } else if (shape === 'star') {
      const points = 5;
      const outerR = baseRadius * 1.3;
      const innerR = baseRadius * 0.5;
      for (let i = 0; i < points * 2; i++) {
        const r = i % 2 === 0 ? outerR : innerR;
        const angle = (i / (points * 2)) * Math.PI * 2 - Math.PI / 2;
        const px = x + Math.cos(angle) * r;
        const py = y + Math.sin(angle) * r;
        if (i === 0) pageCtx.moveTo(px, py);
        else pageCtx.lineTo(px, py);
      }
    } else if (shape === 'huge') {
      const points = 16;
      for (let i = 0; i < points; i++) {
        const angle = (i / points) * Math.PI * 2;
        const r = baseRadius * (0.7 + Math.random() * 0.6);
        const px = x + Math.cos(angle) * r;
        const py = y + Math.sin(angle) * r;
        if (i === 0) pageCtx.moveTo(px, py);
        else pageCtx.lineTo(px, py);
      }
    } else if (shape === 'pellet') {
      pageCtx.arc(x, y, baseRadius, 0, Math.PI * 2);
    } else {
      const points = 10;
      for (let i = 0; i < points; i++) {
        const angle = (i / points) * Math.PI * 2;
        const r = baseRadius * (0.75 + Math.random() * 0.5);
        const px = x + Math.cos(angle) * r;
        const py = y + Math.sin(angle) * r;
        if (i === 0) pageCtx.moveTo(px, py);
        else pageCtx.lineTo(px, py);
      }
    }

    pageCtx.closePath();
    pageCtx.fill();

    spawnPaperShards(x, y, baseRadius);

    // Balanced Destruction Scoring
    destructionScore += (baseRadius * baseRadius * 0.005);
    destructionPercent = Math.min(100, Math.round(destructionScore));
    updateHUD();
  }

  // Laser Trench Cut
  function punchLaserTrench(x1: number, y1: number, x2: number, y2: number, width: number) {
    if (!pageCtx) return;

    pageCtx.globalCompositeOperation = 'destination-out';
    pageCtx.lineWidth = width;
    pageCtx.lineCap = 'round';
    pageCtx.beginPath();
    pageCtx.moveTo(x1, y1);
    pageCtx.lineTo(x2, y2);
    pageCtx.stroke();

    spawnPaperShards(x2, y2, width * 1.5);
    destructionScore += 0.3;
    destructionPercent = Math.min(100, Math.round(destructionScore));
    updateHUD();
  }

  function spawnPaperShards(x: number, y: number, radius: number) {
    const count = Math.min(18, Math.max(2, Math.floor(radius * 0.5)));
    for (let i = 0; i < count; i++) {
      const angle = Math.random() * Math.PI * 2;
      const speed = Math.random() * 6 + 2;
      paperShards.push({
        x: x + (Math.random() - 0.5) * radius,
        y: y + (Math.random() - 0.5) * radius,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed - 2.5,
        rot: Math.random() * Math.PI * 2,
        vRot: (Math.random() - 0.5) * 0.4,
        size: Math.random() * 9 + 3,
        color: Math.random() > 0.4 ? '#FFFFFF' : '#CBD5E1',
        life: 0,
        maxLife: Math.random() * 35 + 20,
      });
    }
  }

  function updateHUD() {
    if (hudBar) hudBar.style.width = `${destructionPercent}%`;
    if (hudPct) hudPct.textContent = `${destructionPercent}%`;
    if (hudDomain) hudDomain.textContent = currentDomain;
  }

  let lastShotTime = 0;
  function shootWeapon() {
    const now = performance.now();
    const gunX = player.x + player.facing * 18;
    const gunY = player.y - 12;

    const targetX = mouseX;
    const targetY = mouseY;
    const angle = Math.atan2(targetY - gunY, targetX - gunX);

    if (currentWeapon === 'pistol') {
      if (now - lastShotTime < 130) return;
      lastShotTime = now;
      sfx.playGunshot();

      const hitX = targetX + (Math.random() - 0.5) * 4;
      const hitY = targetY + (Math.random() - 0.5) * 4;
      punchBlastHole(hitX, hitY, Math.random() * 3 + 5, 'small');

      projectiles.push({
        x: gunX,
        y: gunY,
        startX: gunX,
        startY: gunY,
        targetX: hitX,
        targetY: hitY,
        totalDist: Math.hypot(hitX - gunX, hitY - gunY),
        vx: (hitX - gunX) / 2.5,
        vy: (hitY - gunY) / 2.5,
        type: 'tracer',
        radius: 2,
        life: 0,
        color: '#FF4081',
      });
    } else if (currentWeapon === 'uzi') {
      if (now - lastShotTime < 65) return;
      lastShotTime = now;
      sfx.playGunshot();

      const hitX = targetX + (Math.random() - 0.5) * 8;
      const hitY = targetY + (Math.random() - 0.5) * 8;
      punchBlastHole(hitX, hitY, Math.random() * 4 + 7, 'jagged');

      projectiles.push({
        x: gunX,
        y: gunY,
        startX: gunX,
        startY: gunY,
        targetX: hitX,
        targetY: hitY,
        totalDist: Math.hypot(hitX - gunX, hitY - gunY),
        vx: (hitX - gunX) / 3,
        vy: (hitY - gunY) / 3,
        type: 'tracer',
        radius: 2.5,
        life: 0,
        color: '#FFEA00',
      });
    } else if (currentWeapon === 'shotgun') {
      if (now - lastShotTime < 280) return;
      lastShotTime = now;
      sfx.playShotgun();

      for (let i = 0; i < 8; i++) {
        const scatterDist = Math.random() * 30 + 4;
        const scatterAngle = Math.random() * Math.PI * 2;
        const pelletX = targetX + Math.cos(scatterAngle) * scatterDist;
        const pelletY = targetY + Math.sin(scatterAngle) * scatterDist;
        
        punchBlastHole(pelletX, pelletY, Math.random() * 5 + 6, 'pellet');

        projectiles.push({
          x: gunX,
          y: gunY,
          startX: gunX,
          startY: gunY,
          targetX: pelletX,
          targetY: pelletY,
          totalDist: Math.hypot(pelletX - gunX, pelletY - gunY),
          vx: (pelletX - gunX) / 3,
          vy: (pelletY - gunY) / 3,
          type: 'tracer',
          radius: 3,
          life: 0,
          color: '#FF3366',
        });
      }
    } else if (currentWeapon === 'gatling') {
      if (now - lastShotTime < 40) return;
      lastShotTime = now;
      sfx.playGunshot();

      const hitX = targetX + (Math.random() - 0.5) * 14;
      const hitY = targetY + (Math.random() - 0.5) * 14;
      punchBlastHole(hitX, hitY, Math.random() * 5 + 9, 'jagged');

      projectiles.push({
        x: gunX,
        y: gunY,
        startX: gunX,
        startY: gunY,
        targetX: hitX,
        targetY: hitY,
        totalDist: Math.hypot(hitX - gunX, hitY - gunY),
        vx: (hitX - gunX) / 2,
        vy: (hitY - gunY) / 2,
        type: 'tracer',
        radius: 3,
        life: 0,
        color: '#FF9900',
      });
    } else if (currentWeapon === 'magic') {
      sfx.playLaser();
      punchLaserTrench(gunX, gunY, targetX, targetY, 14);

      projectiles.push({
        x: targetX,
        y: targetY,
        startX: targetX,
        startY: targetY,
        targetX: targetX,
        targetY: targetY,
        totalDist: 0,
        vx: (Math.random() - 0.5) * 4,
        vy: -Math.random() * 4 - 2,
        type: 'star',
        radius: 6,
        life: 0,
        color: '#00F0FF',
      });
    } else if (currentWeapon === 'rocket') {
      if (now - lastShotTime < 400) return;
      lastShotTime = now;
      sfx.playExplosion();

      const dist = Math.hypot(targetX - gunX, targetY - gunY);
      const speed = 18;
      projectiles.push({
        x: gunX,
        y: gunY,
        startX: gunX,
        startY: gunY,
        targetX: targetX,
        targetY: targetY,
        totalDist: Math.max(1, dist),
        vx: dist > 0 ? ((targetX - gunX) / dist) * speed : 0,
        vy: dist > 0 ? ((targetY - gunY) / dist) * speed : 0,
        type: 'rocket',
        radius: 8,
        life: 0,
        color: '#FF0055',
      });
    } else if (currentWeapon === 'nuke') {
      if (now - lastShotTime < 1800) return;
      lastShotTime = now;
      sfx.playNuke();

      punchBlastHole(targetX, targetY, 130, 'huge');

      for (let i = 0; i < 8; i++) {
        setTimeout(() => {
          if (!pageCanvas) return;
          const rx = targetX + (Math.random() - 0.5) * 340;
          const ry = targetY + (Math.random() - 0.5) * 240;
          punchBlastHole(rx, ry, 95, 'huge');
        }, i * 50);
      }
    }
