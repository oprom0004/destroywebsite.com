---
interface Props {
  initialTargetUrl?: string;
  initialTargetDomain?: string;
}

const {
  initialTargetUrl = 'https://wikipedia.org',
  initialTargetDomain = 'wikipedia.org',
} = Astro.props;
---

<div id="game-container" class="relative w-full rounded-3xl overflow-hidden border-2 border-[#ff659c]/50 shadow-[0_0_50px_rgba(255,101,156,0.3)] select-none bg-[#0284c7] aspect-[16/10] min-h-[580px] sm:min-h-[660px] group">
  
  <!-- LAYER 0: Kawaii Pixel Sky & Ocean Backdrop (Behind the Holes) -->
  <div id="kawaii-sky-bg" class="absolute inset-0 z-0 bg-gradient-to-b from-[#7dd3fc] via-[#38bdf8] to-[#0284c7] overflow-hidden pointer-events-none">
    <!-- Fluffy Pixel Clouds -->
    <div class="absolute top-12 left-12 w-36 h-12 bg-white/85 rounded-full blur-[1px] shadow-[0_0_20px_rgba(255,255,255,0.6)]"></div>
    <div class="absolute top-20 left-32 w-28 h-9 bg-white/95 rounded-full blur-[1px]"></div>
    
    <div class="absolute top-16 right-20 w-44 h-14 bg-white/80 rounded-full blur-[1px]"></div>
    <div class="absolute top-8 right-40 w-32 h-10 bg-white/90 rounded-full blur-[1px]"></div>

    <div class="absolute top-28 left-1/2 -translate-x-1/2 w-56 h-14 bg-white/65 rounded-full blur-[1px]"></div>

    <!-- Distant Tropical Island Silhouette -->
    <div class="absolute bottom-28 left-1/4 w-48 h-12 bg-[#0369a1]/40 rounded-t-full"></div>
    <div class="absolute bottom-28 right-1/4 w-60 h-16 bg-[#0369a1]/30 rounded-t-full"></div>

    <!-- Pixel Ocean Waves -->
    <div class="absolute bottom-0 inset-x-0 h-36 bg-gradient-to-t from-[#0369a1] to-[#0284c7] [background-size:24px_12px] [background-image:linear-gradient(to_right,rgba(255,255,255,0.25)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.15)_1px,transparent_1px)] opacity-85"></div>
  </div>

  <!-- LAYER 1: Destructible Webpage Foreground Canvas -->
  <canvas id="page-canvas" class="absolute inset-0 w-full h-full z-10 cursor-crosshair"></canvas>

  <!-- LAYER 2: Physics Particles, Projectiles & Player Canvas -->
  <canvas id="fx-canvas" class="absolute inset-0 w-full h-full z-20 pointer-events-none"></canvas>

  <!-- HUD: Top-Left Domain & Destruction Meter -->
  <div class="absolute top-4 left-4 z-30 flex items-center gap-3">
    <div class="px-4 py-2.5 bg-[#25093e]/90 backdrop-blur-md border border-[#ff659c]/60 rounded-2xl shadow-xl flex flex-col gap-1 min-w-[170px]">
      <div class="flex items-center justify-between text-xs font-mono">
        <span id="hud-domain" class="text-white font-black truncate max-w-[110px]">{initialTargetDomain}</span>
        <button id="btn-reopen-modal" class="text-[10px] text-[#00f0ff] hover:underline font-bold">Change ⚙️</button>
      </div>
      <div class="flex items-center justify-between gap-2">
        <div class="flex-1 h-2.5 bg-[#120420] rounded-full overflow-hidden p-0.5 border border-[#ff659c]/30">
          <div id="hud-bar" class="h-full bg-gradient-to-r from-[#ffea00] via-[#ff0077] to-[#00f0ff] rounded-full transition-all duration-150" style="width: 0%"></div>
        </div>
        <span id="hud-pct" class="text-xs font-mono font-black text-[#ff659c]">0%</span>
      </div>
    </div>
  </div>

  <!-- HUD: Top-Right Sound, Snapshot & Repair Controls -->
  <div class="absolute top-4 right-4 z-30 flex items-center gap-2">
    <button
      id="btn-snapshot"
      class="px-3 py-1.5 bg-gradient-to-r from-[#ff0077] to-[#9900ff] hover:scale-105 active:scale-95 backdrop-blur-md border border-[#ff659c] rounded-xl text-xs font-mono font-black text-white shadow-[0_0_15px_rgba(255,0,119,0.5)] transition-all flex items-center gap-1.5"
      title="Generate Demolition Certificate & Share"
    >
      <span>📸</span>
      <span class="hidden sm:inline">Certificate</span>
    </button>
    <button
      id="btn-sound"
      class="px-3 py-1.5 bg-[#25093e]/90 hover:bg-[#ff4081]/30 backdrop-blur-md border border-[#ff659c]/50 rounded-xl text-xs font-mono text-white transition-colors"
      title="Toggle Audio"
    >
      🔊 SFX: ON
    </button>
    <button
      id="btn-repair"
      class="px-3 py-1.5 bg-[#25093e]/90 hover:bg-[#ff4081]/30 backdrop-blur-md border border-[#ff659c]/50 rounded-xl text-xs font-mono text-white transition-colors"
      title="Restore Webpage"
    >
      🔄 Repair
    </button>
  </div>

  <!-- HUD: Bottom-Center Floating Pixel Weapon Dock -->
  <div class="absolute bottom-4 inset-x-0 z-30 flex justify-center px-4 pointer-events-auto">
    <div class="flex items-center gap-1.5 sm:gap-2 p-2 bg-[#25093e]/95 backdrop-blur-md border-2 border-[#ff659c]/60 rounded-2xl shadow-[0_0_30px_rgba(255,64,129,0.4)] overflow-x-auto max-w-full">
      <!-- 1: Pistol -->
      <button class="weapon-slot active px-3 py-1.5 rounded-xl border border-[#ff0077] bg-[#ff0077]/30 text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="pistol">
        <span class="text-sm">🪄</span>
        <span class="hidden sm:inline">Pistol</span>
        <span class="text-[10px] opacity-60">1</span>
      </button>

      <!-- 2: Uzi -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="uzi">
        <span class="text-sm">🔫</span>
        <span class="hidden sm:inline">Uzi</span>
        <span class="text-[10px] opacity-60">2</span>
      </button>

      <!-- 3: Shotgun -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="shotgun">
        <span class="text-sm">💥</span>
        <span class="hidden sm:inline">Shotgun</span>
        <span class="text-[10px] opacity-60">3</span>
      </button>

      <!-- 4: Heavy Gatling -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="gatling">
        <span class="text-sm">🌪️</span>
        <span class="hidden sm:inline">Gatling</span>
        <span class="text-[10px] opacity-60">4</span>
      </button>

      <!-- 5: Laser Beam -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="magic">
        <span class="text-sm">⭐</span>
        <span class="hidden sm:inline">Laser Beam</span>
        <span class="text-[10px] opacity-60">5</span>
      </button>

      <!-- 6: RPG Rocket -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="rocket">
        <span class="text-sm">🚀</span>
        <span class="hidden sm:inline">Rocket</span>
        <span class="text-[10px] opacity-60">6</span>
      </button>

      <!-- 7: Orbital Cannon -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="nuke">
        <span class="text-sm">☢️</span>
        <span class="hidden sm:inline">Cannon</span>
        <span class="text-[10px] opacity-60">7</span>
      </button>

      <!-- RMB: Strawberry Grenade -->
      <div class="border-l border-white/20 pl-1.5 sm:pl-2">
        <button class="px-2.5 py-1.5 rounded-xl border border-[#ff0077]/40 bg-[#ff0077]/20 text-[#ffea00] font-mono text-xs font-black flex items-center gap-1" title="Right-Click anywhere to throw Strawberry Grenade!">
          <span>🍓 RMB</span>
        </button>
      </div>
    </div>
  </div>

  <!-- SHARE & DEMOLITION CERTIFICATE MODAL -->
  <div id="cert-modal" class="hidden absolute inset-0 z-50 bg-[#0f021e]/85 backdrop-blur-lg items-center justify-center p-4">
    <div class="w-full max-w-xl bg-gradient-to-b from-[#2d084d] to-[#140124] border-2 border-[#ff659c] rounded-3xl p-5 sm:p-6 shadow-[0_0_80px_rgba(255,101,156,0.7)] space-y-4 text-center relative max-h-[90vh] overflow-y-auto">
      
      <!-- Close Button -->
      <button id="btn-close-cert" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white font-mono text-sm flex items-center justify-center transition-colors">
        ✕
      </button>

      <!-- Badge Header -->
      <div class="inline-flex items-center gap-2 px-4 py-1 bg-[#ff659c]/20 border border-[#ff659c]/50 rounded-full text-xs font-mono font-bold text-[#ff9ebb]">
        <span>🏆</span>
        <span>OFFICIAL CERTIFICATE OF WEB DEMOLITION</span>
      </div>

      <!-- Live Generated Snapshot Canvas -->
      <div class="relative rounded-2xl overflow-hidden border-2 border-[#00f0ff]/60 shadow-[0_0_30px_rgba(0,240,255,0.3)] bg-[#0a0014] aspect-[16/10] max-h-[250px] flex items-center justify-center">
        <canvas id="cert-canvas" class="w-full h-full object-contain"></canvas>
      </div>

      <!-- Stats Summary Grid -->
      <div class="grid grid-cols-3 gap-2 bg-[#1b0330]/80 p-3 rounded-2xl border border-purple-500/30 text-xs font-mono">
        <div>
          <span class="text-purple-300 block text-[10px]">TARGET DOMAIN</span>
          <span id="cert-domain-text" class="text-white font-bold truncate block">wikipedia.org</span>
        </div>
        <div>
          <span class="text-purple-300 block text-[10px]">DESTRUCTION</span>
          <span id="cert-pct-text" class="text-[#ff659c] font-black text-sm block">100%</span>
        </div>
        <div>
          <span class="text-purple-300 block text-[10px]">THREAT RANK</span>
          <span id="cert-rank-text" class="text-[#ffea00] font-black text-sm block">S-CLASS ⚡</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 pt-1">
        <!-- Copy Image -->
        <button id="btn-copy-cert" class="px-4 py-2.5 bg-gradient-to-r from-[#00f0ff] to-[#0077ff] hover:scale-105 active:scale-95 text-[#001122] font-black text-xs sm:text-sm rounded-xl shadow-[0_0_20px_rgba(0,240,255,0.5)] font-mono transition-transform flex items-center gap-1.5">
          <span>📋</span>
          <span id="copy-btn-text">Copy Image</span>
        </button>

        <!-- Download PNG -->
        <button id="btn-download-cert" class="px-4 py-2.5 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c] text-white font-bold text-xs sm:text-sm rounded-xl font-mono transition-all flex items-center gap-1.5">
          <span>💾</span>
          <span>Download PNG</span>
        </button>

        <!-- Share to X (Twitter) -->
        <button id="btn-share-x" class="px-4 py-2.5 bg-black hover:bg-neutral-800 border border-white/30 text-white font-bold text-xs sm:text-sm rounded-xl font-mono transition-all flex items-center gap-1.5">
          <span>𝕏</span>
          <span>Share to X</span>
        </button>

        <!-- Copy Challenge Link -->
        <button id="btn-share-link" class="px-4 py-2.5 bg-[#1b0330] hover:bg-[#3b0863] border border-purple-500/40 text-purple-200 font-bold text-xs sm:text-sm rounded-xl font-mono transition-all flex items-center gap-1.5">
          <span>🔗</span>
          <span id="link-btn-text">Challenge Link</span>
        </button>
      </div>

    </div>
  </div>

  <!-- CENTER MODAL: Kawaii Cyber-Arcade Launcher Modal -->
  <div id="arcade-modal" class="absolute inset-0 z-40 bg-[#10021f]/75 backdrop-blur-md flex items-center justify-center p-4 transition-opacity duration-300">
    <div class="w-full max-w-lg bg-gradient-to-b from-[#3b0d61] to-[#1e0436] border-2 border-[#ff659c] rounded-3xl p-6 sm:p-8 shadow-[0_0_60px_rgba(255,101,156,0.6)] space-y-6 text-center">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#ff659c]/20 border border-[#ff659c]/40 rounded-full text-xs font-mono font-bold text-[#ff9ebb]">
        <span>✨</span>
        <span>Kawaii Cyber-Arcade Edition</span>
      </div>

      <!-- Gradient Pixel Title -->
      <h2 class="text-3xl sm:text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[#ff4081] via-[#ffea00] to-[#00f0ff] tracking-tight font-pixel">
        Destroy Any Website
      </h2>

      <p class="text-xs sm:text-sm text-[#e2d4f0] -mt-2">
        Type an address, smash everything with cute weapons! 🐾 ✨
      </p>

      <!-- URL Input Bar -->
      <div class="flex items-center bg-[#130324] border-2 border-[#ff659c]/60 rounded-2xl p-1.5 shadow-inner focus-within:border-[#00f0ff] transition-colors">
        <span class="text-xs font-mono text-[#ff659c] font-bold px-3 select-none">https://</span>
        <input
          type="text"
          id="modal-url-input"
          value="wikipedia.org"
          placeholder="e.g. google.com, school.edu..."
          class="w-full bg-transparent text-white text-xs sm:text-sm font-mono focus:outline-none placeholder:text-purple-400/50"
        />
        <button
          id="btn-modal-destroy"
          class="px-5 py-2.5 bg-gradient-to-r from-[#ff4081] to-[#ff0055] hover:scale-105 active:scale-95 text-white font-black text-xs sm:text-sm rounded-xl shadow-[0_0_20px_rgba(255,0,85,0.6)] font-mono transition-transform flex items-center gap-1 shrink-0"
        >
          <span>⚡ Destroy</span>
        </button>
      </div>

      <!-- Quick Try Chips -->
      <div class="space-y-2 text-left">
        <span class="text-[11px] font-mono text-purple-300 font-bold">Try presets:</span>
        <div class="flex flex-wrap gap-2">
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="wikipedia.org" data-theme="wiki">
            📄 Wikipedia
          </button>
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="google.com" data-theme="google">
            🔍 Google Search
          </button>
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="candyland.io" data-theme="candy">
            🍬 Candyland Demo
          </button>
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="schoolportal.edu" data-theme="school">
            🏫 School Portal
          </button>
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="reddit.com" data-theme="reddit">
            🐱 Reddit / Cute Cats
          </button>
        </div>
      </div>

      <!-- Controls Cheatsheet Footer in Modal -->
      <div class="pt-3 border-t border-purple-800/60 flex items-center justify-between text-[11px] font-mono text-purple-300">
        <div class="flex items-center gap-3">
          <span><kbd class="px-1.5 py-0.5 bg-[#130324] text-[#00f0ff] rounded">WASD</kbd> move/jump</span>
          <span>🖱️ Wheel switch</span>
          <span>🖱️ Click shoot</span>
        </div>
        <span class="text-[#ff659c] font-bold">🍓 RMB grenade</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { sfx } from '../lib/sound';

  const container = document.getElementById('game-container');
  const pageCanvas = document.getElementById('page-canvas') as HTMLCanvasElement;
  const fxCanvas = document.getElementById('fx-canvas') as HTMLCanvasElement;
  const pageCtx = pageCanvas?.getContext('2d');
  const fxCtx = fxCanvas?.getContext('2d');

  const hudDomain = document.getElementById('hud-domain');
  const hudBar = document.getElementById('hud-bar');
  const hudPct = document.getElementById('hud-pct');
  const modal = document.getElementById('arcade-modal');
  const modalInput = document.getElementById('modal-url-input') as HTMLInputElement;

  let currentDomain = 'wikipedia.org';
  let currentWeapon = 'pistol';
  let isMouseDown = false;
  let mouseX = 400;
  let mouseY = 300;
  let destructionScore = 0;
  let destructionPercent = 0;

  // Exact Viewport Dimensions
  let width = 1000;
  let height = 640;

  // Solid Platforms for jumping & standing
  let platforms: { y: number; minX: number; maxX: number }[] = [];

  const player = {
    x: 500,
    y: 140,
    vx: 0,
    vy: 0,
    facing: 1,
    jetpack: false,
    grounded: false,
  };

  const keys: Record<string, boolean> = {};

  interface Projectile {
    x: number;
    y: number;
    startX: number;
    startY: number;
    targetX: number;
    targetY: number;
    totalDist: number;
    vx: number;
    vy: number;
    type: string;
    radius: number;
    life: number;
    color: string;
  }

  interface PaperShard {
    x: number;
    y: number;
    vx: number;
    vy: number;
    rot: number;
    vRot: number;
    size: number;
    color: string;
    life: number;
    maxLife: number;
  }

  const projectiles: Projectile[] = [];
  const paperShards: PaperShard[] = [];

  let activeLiveImg: HTMLImageElement | null = null;
  let isLoadingLive = false;

  function loadLiveWebsiteScreenshot(urlOrDomain: string) {
    let fullUrl = urlOrDomain.trim();
    if (!fullUrl.startsWith('http://') && !fullUrl.startsWith('https://')) {
      fullUrl = 'https://' + fullUrl;
    }

    try {
      const parsed = new URL(fullUrl);
      currentDomain = parsed.hostname;
    } catch {
      currentDomain = urlOrDomain;
    }

    isLoadingLive = true;
    renderScanningHUD(currentDomain);

    const img = new Image();
    img.crossOrigin = 'anonymous';

    const proxyUrl = `https://api.microlink.io/?url=${encodeURIComponent(fullUrl)}&screenshot=true&embed=screenshot.url`;

    img.onload = () => {
      isLoadingLive = false;
      activeLiveImg = img;
      renderActiveCanvas();
    };

    img.onerror = () => {
      isLoadingLive = false;
      activeLiveImg = null;
      renderProceduralFallback(currentDomain);
    };

    img.src = proxyUrl;
  }

  function renderScanningHUD(domain: string) {
    if (!pageCtx || !pageCanvas) return;
    const w = pageCanvas.width;
    const h = pageCanvas.height;

    pageCtx.globalCompositeOperation = 'source-over';
    pageCtx.fillStyle = '#0f051d';
    pageCtx.fillRect(0, 0, w, h);

    // Radar Scanning Grid
    pageCtx.strokeStyle = 'rgba(0, 240, 255, 0.25)';
    pageCtx.lineWidth = 1;
    for (let x = 0; x < w; x += 40) {
      pageCtx.beginPath();
      pageCtx.moveTo(x, 0);
      pageCtx.lineTo(x, h);
      pageCtx.stroke();
    }
    for (let y = 0; y < h; y += 40) {
      pageCtx.beginPath();
      pageCtx.moveTo(0, y);
      pageCtx.lineTo(w, y);
      pageCtx.stroke();
    }

    pageCtx.fillStyle = '#00F0FF';
    pageCtx.font = 'bold 20px monospace';
    pageCtx.textAlign = 'center';
    pageCtx.fillText(`📡 INTERCEPTING LIVE FEED: ${domain.toUpperCase()}`, w / 2, h / 2 - 20);

    pageCtx.fillStyle = '#FF659C';
    pageCtx.font = '13px monospace';
    pageCtx.fillText('Rendering real-world DOM structure & visual layers...', w / 2, h / 2 + 15);
    pageCtx.textAlign = 'left';
  }

  function resizeCanvases() {
    if (!container || !pageCanvas || !fxCanvas) return;
    width = container.clientWidth || 1000;
    height = container.clientHeight || 640;

    pageCanvas.width = width;
    pageCanvas.height = height;
    fxCanvas.width = width;
    fxCanvas.height = height;

    // Build solid platform collision levels
    platforms = [
      { y: 150, minX: 0, maxX: width }, // Top header platform
      { y: 340, minX: 0, maxX: width }, // Mid search platform
      { y: height - 55, minX: 0, maxX: width } // Bottom solid floor
    ];
  }

  function renderActiveCanvas() {
    if (!pageCtx || !pageCanvas) return;

    resizeCanvases();

    pageCtx.globalCompositeOperation = 'source-over';
    pageCtx.fillStyle = '#FFFFFF';
    pageCtx.fillRect(0, 0, width, height);

    if (activeLiveImg) {
      // Draw live website screenshot contained nicely within bounds
      pageCtx.drawImage(activeLiveImg, 0, 0, width, height);
    } else {
      renderProceduralFallback(currentDomain);
    }

    // Reset player standing solidly on top platform
    player.x = width / 2;
    player.y = 150;
    player.vx = 0;
    player.vy = 0;
    player.grounded = true;

    destructionScore = 0;
    destructionPercent = 0;
    updateHUD();
  }

  function renderProceduralFallback(domain: string) {
    if (!pageCtx || !pageCanvas) return;
    const w = width;
    const h = height;

    // Header Navbar
    pageCtx.fillStyle = '#0f172a';
    pageCtx.fillRect(0, 0, w, 56);
    pageCtx.fillStyle = '#FFFFFF';
    pageCtx.font = 'bold 18px sans-serif';
    pageCtx.fillText(`🌐 https://${domain}`, 24, 34);

    pageCtx.fillStyle = '#38bdf8';
    pageCtx.fillRect(w - 150, 14, 126, 28);
    pageCtx.fillStyle = '#0f172a';
    pageCtx.font = 'bold 12px sans-serif';
    pageCtx.fillText('Sign In / Portal', w - 136, 32);

    // Hero Header
    pageCtx.fillStyle = '#1e293b';
    pageCtx.font = 'bold 36px sans-serif';
    pageCtx.fillText(`Welcome to ${domain}`, 40, 125);
    pageCtx.fillStyle = '#64748b';
    pageCtx.font = '14px sans-serif';
    pageCtx.fillText(`Interactive demolition sandbox. Destroy any element on this page!`, 40, 155);

    // Content Card
    pageCtx.fillStyle = '#f8fafc';
    pageCtx.fillRect(40, 185, w - 80, 260);
    pageCtx.strokeStyle = '#e2e8f0';
    pageCtx.lineWidth = 1;
    pageCtx.strokeRect(40, 185, w - 80, 260);

    pageCtx.fillStyle = '#0284c7';
    pageCtx.fillRect(60, 215, 160, 40);
    pageCtx.fillStyle = '#FFFFFF';
