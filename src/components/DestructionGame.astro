  function throwGrenade() {
    sfx.playBounce();
    const gunX = player.x + player.facing * 18;
    const gunY = player.y - 12;
    const targetX = mouseX;
    const targetY = mouseY;
    const dist = Math.hypot(targetX - gunX, targetY - gunY);
    const timeFrames = Math.max(20, Math.min(45, dist / 14));
    const gravity = 0.4;
    
    const vx = (targetX - gunX) / timeFrames;
    const vy = (targetY - gunY - 0.5 * gravity * timeFrames * timeFrames) / timeFrames;

    projectiles.push({
      x: gunX,
      y: gunY,
      startX: gunX,
      startY: gunY,
      targetX: targetX,
      targetY: targetY,
      totalDist: dist,
      vx: vx,
      vy: vy,
      type: 'grenade',
      radius: 7,
      life: 0,
      color: '#FF0077',
    });
  }

  // Draw Kawaii Anime Bunny Character
  let walkCycle = 0;
  function drawPlayer(ctx: CanvasRenderingContext2D) {
    ctx.save();
    ctx.translate(player.x, player.y);
    if (player.facing === -1) ctx.scale(-1, 1);

    const isMoving = Math.abs(player.vx) > 0.5;
    if (isMoving) walkCycle += 0.25;

    // Jetpack flames
    if (player.jetpack) {
      ctx.fillStyle = '#00F0FF';
      ctx.fillRect(-16, 12, 6, Math.random() * 16 + 8);
      ctx.fillStyle = '#FFEA00';
      ctx.fillRect(-14, 14, 4, Math.random() * 10 + 4);
    }

    // Shadow on surface
    ctx.fillStyle = 'rgba(0, 0, 0, 0.25)';
    ctx.beginPath();
    ctx.ellipse(0, 24, 14, 4, 0, 0, Math.PI * 2);
    ctx.fill();

    // Cute Orange Bunny Body
    ctx.fillStyle = '#FF6B00';
    ctx.fillRect(-12, -14, 24, 24);
    ctx.fillStyle = '#FF9E00';
    ctx.fillRect(-8, -10, 16, 16);

    // Jetpack Booster
    ctx.fillStyle = '#25093E';
    ctx.fillRect(-16, -10, 6, 18);
    ctx.fillStyle = '#00F0FF';
    ctx.fillRect(-16, -6, 2, 8);

    // Bunny Head
    ctx.fillStyle = '#FFE5D9';
    ctx.fillRect(-11, -32, 22, 20);

    // Long Kawaii Ears
    ctx.fillStyle = '#FF6B00';
    ctx.fillRect(-12, -44, 7, 14);
    ctx.fillRect(5, -44, 7, 14);
    ctx.fillStyle = '#FF4081';
    ctx.fillRect(-10, -42, 3, 10);
    ctx.fillRect(7, -42, 3, 10);

    // Anime Eyes
    ctx.fillStyle = '#1A0033';
    ctx.fillRect(2, -26, 4, 8);
    ctx.fillRect(-7, -26, 4, 8);
    // Eye Sparkle
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(3, -25, 2, 3);
    ctx.fillRect(-6, -25, 2, 3);

    // Cute Cheerful Blush
    ctx.fillStyle = '#FF4081';
    ctx.fillRect(4, -18, 4, 3);
    ctx.fillRect(-9, -18, 4, 3);

    // Running Legs
    const legOffset1 = isMoving ? Math.sin(walkCycle) * 6 : 0;
    const legOffset2 = isMoving ? -Math.sin(walkCycle) * 6 : 0;

    ctx.fillStyle = '#1A0033';
    ctx.fillRect(-8 + legOffset1, 10, 6, 12);
    ctx.fillRect(2 + legOffset2, 10, 6, 12);
    ctx.fillStyle = '#FF4081';
    ctx.fillRect(-10 + legOffset1, 18, 8, 5);
    ctx.fillRect(2 + legOffset2, 18, 8, 5);

    // Active Weapon in Hand
    ctx.fillStyle = '#334155';
    ctx.fillRect(6, -6, 16, 7);
    ctx.fillStyle = '#FF4081';
    ctx.fillRect(8, -8, 6, 3);
    ctx.fillStyle = '#FFEA00';
    ctx.fillRect(18, -8, 5, 4);

    ctx.restore();
  }

  function gameLoop() {
    if (fxCtx && fxCanvas) {
      fxCtx.clearRect(0, 0, width, height);

      // Multi-Input Check: WASD / Arrows
      const keyLeft = keys['KeyA'] || keys['ArrowLeft'] || keys['a'] || keys['A'];
      const keyRight = keys['KeyD'] || keys['ArrowRight'] || keys['d'] || keys['D'];
      const keyUp = keys['Space'] || keys['KeyW'] || keys['ArrowUp'] || keys['w'] || keys['W'];
      const keyDown = keys['KeyS'] || keys['ArrowDown'] || keys['s'] || keys['S'];

      // Horizontal movement
      if (keyLeft) {
        player.vx = -5;
        player.facing = -1;
      } else if (keyRight) {
        player.vx = 5;
        player.facing = 1;
      } else if (isMouseDown) {
        const dx = mouseX - player.x;
        if (Math.abs(dx) > 35) {
          player.vx = Math.sign(dx) * 4;
          player.facing = Math.sign(dx) as 1 | -1;
        } else {
          player.vx *= 0.75;
          player.facing = (mouseX >= player.x ? 1 : -1) as 1 | -1;
        }
      } else {
        player.vx *= 0.8;
      }

      // Vertical jumping & jetpack
      if (keyUp) {
        player.vy = -6.5;
        player.jetpack = true;
        player.grounded = false;
      } else {
        player.jetpack = false;
        player.vy += 0.38; // Normal Gravity
      }

      const prevY = player.y;
      player.x += player.vx;
      player.y += player.vy;

      // Platform Collision Detection
      player.grounded = false;
      const floorY = height - 55;

      if (player.y >= floorY) {
        player.y = floorY;
        player.vy = 0;
        player.grounded = true;
      } else if (!keyDown && player.vy > 0) {
        // Check floating platforms if falling downward
        for (const plat of platforms) {
          if (prevY <= plat.y && player.y >= plat.y && player.x >= plat.minX && player.x <= plat.maxX) {
            player.y = plat.y;
            player.vy = 0;
            player.grounded = true;
            break;
          }
        }
      }

      // Horizontal Boundaries
      if (player.x < 30) player.x = 30;
      if (player.x > width - 30) player.x = width - 30;
      if (player.y < 50) {
        player.y = 50;
        player.vy = 0;
      }

      // Continuous firing
      if (isMouseDown && !modal?.classList.contains('flex')) {
        shootWeapon();
      }

      // Projectiles loop
      for (let i = projectiles.length - 1; i >= 0; i--) {
        const p = projectiles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life++;

        if (p.type === 'grenade') {
          p.vy += 0.35;
          fxCtx.font = '16px serif';
          fxCtx.fillText('🍓', p.x - 8, p.y + 6);

          const distToTarget = Math.hypot(p.x - p.targetX, p.y - p.targetY);
          if (distToTarget < 20 || p.life > 40) {
            sfx.playExplosion();
            punchBlastHole(p.targetX, p.targetY, 75, 'huge');
            projectiles.splice(i, 1);
            continue;
          }
        } else if (p.type === 'rocket') {
          // Draw Rocket
          fxCtx.save();
          const angle = Math.atan2(p.vy, p.vx);
          fxCtx.translate(p.x, p.y);
          fxCtx.rotate(angle);

          fxCtx.fillStyle = '#FF0055';
          fxCtx.fillRect(-10, -4, 16, 8);
          fxCtx.fillStyle = '#FFEA00';
          fxCtx.beginPath();
          fxCtx.moveTo(6, -4);
          fxCtx.lineTo(14, 0);
          fxCtx.lineTo(6, 4);
          fxCtx.closePath();
          fxCtx.fill();
          fxCtx.fillStyle = '#00F0FF';
          fxCtx.fillRect(-10, -7, 4, 14);

          fxCtx.fillStyle = Math.random() > 0.5 ? '#FF9900' : '#FFEA00';
          fxCtx.fillRect(-16, -3, 6, 6);
          fxCtx.restore();

          const distTraveled = Math.hypot(p.x - p.startX, p.y - p.startY);
          const distToTarget = Math.hypot(p.x - p.targetX, p.y - p.targetY);

          if (distTraveled >= p.totalDist || distToTarget <= 20 || p.life > 50) {
            sfx.playExplosion();
            punchBlastHole(p.targetX, p.targetY, 75, 'huge');
            projectiles.splice(i, 1);
            continue;
          }
        } else if (p.type === 'star') {
          fxCtx.font = '14px serif';
          fxCtx.fillText('⭐', p.x - 6, p.y + 5);
          if (p.life > 15) {
            punchBlastHole(p.targetX, p.targetY, 26, 'star');
            projectiles.splice(i, 1);
            continue;
          }
        } else {
          // Tracer
          fxCtx.fillStyle = p.color;
          fxCtx.beginPath();
          fxCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          fxCtx.fill();

          if (p.life > 10) {
            projectiles.splice(i, 1);
            continue;
          }
        }
      }

      // Paper shards
      for (let i = paperShards.length - 1; i >= 0; i--) {
        const s = paperShards[i];
        s.x += s.vx;
        s.y += s.vy;
        s.vy += 0.25;
        s.rot += s.vRot;
        s.life++;

        fxCtx.save();
        fxCtx.translate(s.x, s.y);
        fxCtx.rotate(s.rot);
        fxCtx.fillStyle = s.color;
        fxCtx.fillRect(-s.size / 2, -s.size / 2, s.size, s.size * 0.7);
        fxCtx.restore();

        if (s.life >= s.maxLife || s.y > height + 20) {
          paperShards.splice(i, 1);
        }
      }

      // Draw Bunny Player on top of all elements!
      drawPlayer(fxCtx);
    }
    requestAnimationFrame(gameLoop);
  }

  // Weapon Switch Helper
  const weaponOrder = ['pistol', 'uzi', 'shotgun', 'gatling', 'magic', 'rocket', 'nuke'];
  function selectWeapon(id: string) {
    currentWeapon = id;
    document.querySelectorAll('.weapon-slot').forEach((btn) => {
      const bId = btn.getAttribute('data-id');
      if (bId === id) {
        btn.classList.add('border-[#ff0077]', 'bg-[#ff0077]/30', 'text-white');
        btn.classList.remove('border-white/10', 'bg-[#120420]/80', 'text-[#cbd5e1]');
      } else {
        btn.classList.remove('border-[#ff0077]', 'bg-[#ff0077]/30', 'text-white');
        btn.classList.add('border-white/10', 'bg-[#120420]/80', 'text-[#cbd5e1]');
      }
    });
  }

  // Keyboard Controls
  window.addEventListener('keydown', (e) => {
    keys[e.code] = true;

    const weaponMap: Record<string, string> = {
      'Digit1': 'pistol',
      'Digit2': 'uzi',
      'Digit3': 'shotgun',
      'Digit4': 'gatling',
      'Digit5': 'magic',
      'Digit6': 'rocket',
      'Digit7': 'nuke',
    };
    if (weaponMap[e.code]) {
      selectWeapon(weaponMap[e.code]);
    }
  });

  window.addEventListener('keyup', (e) => {
    keys[e.code] = false;
  });

  // Mouse Wheel Weapon Switching
  container?.addEventListener('wheel', (e) => {
    e.preventDefault();
    const currIdx = weaponOrder.indexOf(currentWeapon);
    if (e.deltaY > 0) {
      const nextIdx = (currIdx + 1) % weaponOrder.length;
      selectWeapon(weaponOrder[nextIdx]);
    } else {
      const prevIdx = (currIdx - 1 + weaponOrder.length) % weaponOrder.length;
      selectWeapon(weaponOrder[prevIdx]);
    }
  }, { passive: false });

  container?.addEventListener('mousemove', (e) => {
    const rect = container.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
  });

  container?.addEventListener('mousedown', (e) => {
    if ((e.target as HTMLElement).closest('#arcade-modal') || (e.target as HTMLElement).closest('.weapon-slot') || (e.target as HTMLElement).closest('button')) {
      return;
    }
    if (e.button === 0) {
      isMouseDown = true;
      shootWeapon();
    } else if (e.button === 2) {
      e.preventDefault();
      throwGrenade();
    }
  });

  window.addEventListener('mouseup', () => {
    isMouseDown = false;
  });

  container?.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    throwGrenade();
  });

  document.querySelectorAll('.weapon-slot').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || 'pistol';
      selectWeapon(id);
    });
  });

  document.getElementById('btn-modal-destroy')?.addEventListener('click', () => {
    const inputVal = modalInput?.value?.trim() || 'wikipedia.org';
    loadLiveWebsiteScreenshot(inputVal);
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  document.querySelectorAll('.btn-quick-try').forEach((chip) => {
    chip.addEventListener('click', () => {
      const url = chip.getAttribute('data-url') || 'wikipedia.org';
      if (modalInput) modalInput.value = url;
      loadLiveWebsiteScreenshot(url);
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });
  });

  document.getElementById('btn-reopen-modal')?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  });

  document.getElementById('btn-repair')?.addEventListener('click', () => {
    renderActiveCanvas();
  });

  document.getElementById('btn-sound')?.addEventListener('click', () => {
    const isMuted = sfx.toggleMute();
    const btn = document.getElementById('btn-sound');
    if (btn) btn.textContent = isMuted ? '🔇 SFX: OFF' : '🔊 SFX: ON';
  });

  // Certificate Generator
  const certModal = document.getElementById('cert-modal');
  const certCanvas = document.getElementById('cert-canvas') as HTMLCanvasElement;
  const certCtx = certCanvas?.getContext('2d');
  const certDomainText = document.getElementById('cert-domain-text');
  const certPctText = document.getElementById('cert-pct-text');
  const certRankText = document.getElementById('cert-rank-text');

  function generateDemolitionCertificate() {
    if (!certCanvas || !certCtx || !pageCanvas) return;

    certCanvas.width = 800;
    certCanvas.height = 500;
    const cw = certCanvas.width;
    const ch = certCanvas.height;

    const grad = certCtx.createLinearGradient(0, 0, cw, ch);
    grad.addColorStop(0, '#15002b');
    grad.addColorStop(0.5, '#2b004d');
    grad.addColorStop(1, '#0d001a');
    certCtx.fillStyle = grad;
    certCtx.fillRect(0, 0, cw, ch);

    certCtx.strokeStyle = '#ff0077';
    certCtx.lineWidth = 6;
    certCtx.strokeRect(16, 16, cw - 32, ch - 32);

    certCtx.strokeStyle = '#00f0ff';
    certCtx.lineWidth = 2;
    certCtx.strokeRect(24, 24, cw - 48, ch - 48);

    certCtx.fillStyle = '#ff0077';
    certCtx.fillRect(cw / 2 - 200, 32, 400, 36);
    certCtx.fillStyle = '#FFFFFF';
    certCtx.font = 'bold 15px monospace';
    certCtx.textAlign = 'center';
    certCtx.fillText('★ OFFICIAL DEMOLITION CERTIFICATE ★', cw / 2, 56);

    const compositeCanvas = document.createElement('canvas');
    compositeCanvas.width = 800;
    compositeCanvas.height = 500;
    const compCtx = compositeCanvas.getContext('2d');
    if (compCtx) {
      const bgGrad = compCtx.createLinearGradient(0, 0, 0, 500);
      bgGrad.addColorStop(0, '#7dd3fc');
      bgGrad.addColorStop(0.5, '#38bdf8');
      bgGrad.addColorStop(1, '#0284c7');
      compCtx.fillStyle = bgGrad;
      compCtx.fillRect(0, 0, 800, 500);

      compCtx.drawImage(pageCanvas, 0, 0, 800, 500);
      if (fxCanvas) compCtx.drawImage(fxCanvas, 0, 0, 800, 500);

      const snapW = cw - 120;
      const snapH = 240;
      const snapX = 60;
      const snapY = 86;

      certCtx.save();
      certCtx.strokeStyle = '#00f0ff';
      certCtx.lineWidth = 3;
      certCtx.strokeRect(snapX - 2, snapY - 2, snapW + 4, snapH + 4);
      certCtx.drawImage(compositeCanvas, snapX, snapY, snapW, snapH);
      certCtx.restore();
    }

    let rank = 'B-RANK SMASHER 🎯';
    if (destructionPercent >= 90) rank = 'S-CLASS OBLITERATOR ⚡';
    else if (destructionPercent >= 60) rank = 'A-RANK DEMOLISHER 💥';
    else if (destructionPercent >= 30) rank = 'B-RANK STRIKER 🎯';

    certCtx.textAlign = 'left';
    certCtx.fillStyle = '#FFFFFF';
    certCtx.font = 'bold 14px monospace';
    certCtx.fillText(`TARGET: ${currentDomain.toUpperCase()}`, 60, 360);

    certCtx.fillStyle = '#ff659c';
    certCtx.font = 'bold 18px monospace';
    certCtx.fillText(`DESTRUCTION: ${destructionPercent}% COMPLETE`, 60, 390);

    certCtx.fillStyle = '#00f0ff';
    certCtx.font = 'bold 13px monospace';
    certCtx.fillText(`RANK: ${rank}`, 60, 418);

    certCtx.save();
    certCtx.translate(cw - 140, 390);
    certCtx.rotate(-0.15);
    certCtx.beginPath();
    certCtx.arc(0, 0, 42, 0, Math.PI * 2);
    certCtx.strokeStyle = '#ffea00';
    certCtx.lineWidth = 3;
    certCtx.stroke();
    certCtx.fillStyle = '#ffea00';
    certCtx.font = 'bold 10px monospace';
    certCtx.textAlign = 'center';
    certCtx.fillText('VERIFIED', 0, -10);
    certCtx.fillText('DEMOLITION', 0, 4);
    certCtx.fillText('★ ★ ★', 0, 18);
    certCtx.restore();

    certCtx.fillStyle = 'rgba(255, 255, 255, 0.4)';
    certCtx.font = '11px monospace';
    certCtx.textAlign = 'center';
    certCtx.fillText('DestroyAnyWebsite Edition • Play free at DestroyWebsite.com', cw / 2, 465);

    if (certDomainText) certDomainText.textContent = currentDomain;
    if (certPctText) certPctText.textContent = `${destructionPercent}%`;
    if (certRankText) certRankText.textContent = rank;

    certModal?.classList.remove('hidden');
    certModal?.classList.add('flex');
  }

  document.getElementById('btn-snapshot')?.addEventListener('click', generateDemolitionCertificate);
  document.getElementById('btn-close-cert')?.addEventListener('click', () => {
    certModal?.classList.add('hidden');
    certModal?.classList.remove('flex');
  });

  document.getElementById('btn-copy-cert')?.addEventListener('click', async () => {
    if (!certCanvas) return;
    try {
      certCanvas.toBlob(async (blob) => {
        if (!blob) return;
        await navigator.clipboard.write([
          new ClipboardItem({ 'image/png': blob })
        ]);
        const copyBtnText = document.getElementById('copy-btn-text');
        if (copyBtnText) {
          copyBtnText.textContent = 'Copied! 🎉';
          setTimeout(() => {
            copyBtnText.textContent = 'Copy Image';
          }, 2500);
        }
      });
    } catch {
      alert('Snapshot created! You can download as PNG.');
    }
  });

  document.getElementById('btn-download-cert')?.addEventListener('click', () => {
    if (!certCanvas) return;
    const a = document.createElement('a');
    a.download = `demolition-certificate-${currentDomain}-${destructionPercent}pct.png`;
    a.href = certCanvas.toDataURL('image/png');
    a.click();
  });

  document.getElementById('btn-share-x')?.addEventListener('click', () => {
    const text = `I just obliterated ${currentDomain} to ${destructionPercent}% on DestroyWebsite.com! 💥 Destroy any website in your browser here:`;
    const shareUrl = `https://destroywebsite.com/?target=${encodeURIComponent(currentDomain)}&challenge=${destructionPercent}`;
    const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(shareUrl)}`;
    window.open(twitterUrl, '_blank', 'width=600,height=400');
  });

  document.getElementById('btn-share-link')?.addEventListener('click', () => {
    const challengeUrl = `${window.location.origin}/?target=${encodeURIComponent(currentDomain)}&challenge=${destructionPercent}`;
    navigator.clipboard.writeText(challengeUrl);
    const linkBtnText = document.getElementById('link-btn-text');
    if (linkBtnText) {
      linkBtnText.textContent = 'Link Copied! 🔗';
      setTimeout(() => {
        linkBtnText.textContent = 'Challenge Link';
      }, 2500);
    }
  });

  const urlParams = new URLSearchParams(window.location.search);
  const initialTarget = urlParams.get('target') || initialTargetDomain || 'wikipedia.org';
  if (modalInput) modalInput.value = initialTarget;

  resizeCanvases();
  renderActiveCanvas();
  loadLiveWebsiteScreenshot(initialTarget);
  gameLoop();
</script>
