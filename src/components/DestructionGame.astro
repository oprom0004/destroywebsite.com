---
interface Props {
  initialTargetUrl?: string;
  initialTargetDomain?: string;
}

const {
  initialTargetUrl = 'https://wikipedia.org',
  initialTargetDomain = 'wikipedia.org',
} = Astro.props;
---

<div id="game-container" class="relative w-full rounded-3xl overflow-hidden border-2 border-[#ff659c]/50 shadow-[0_0_50px_rgba(255,101,156,0.3)] select-none bg-[#1a052e] aspect-[16/10] min-h-[580px] sm:min-h-[640px] group">
  
  <!-- LAYER 0: Synthwave Sunset Pixel City Backdrop (Behind the Holes) -->
  <div id="synthwave-bg" class="absolute inset-0 z-0 bg-gradient-to-b from-[#1a0033] via-[#4d0066] to-[#ff4081] overflow-hidden pointer-events-none">
    <!-- Neon Sun -->
    <div class="absolute top-[18%] left-1/2 -translate-x-1/2 w-48 h-48 rounded-full bg-gradient-to-t from-[#ffea00] to-[#ff0055] shadow-[0_0_80px_rgba(255,0,85,0.8)] opacity-90"></div>
    
    <!-- Synthwave Grid Ground -->
    <div class="absolute bottom-0 inset-x-0 h-40 bg-gradient-to-t from-[#00f2fe]/20 to-transparent [background-size:30px_30px] [background-image:linear-gradient(to_right,rgba(0,242,254,0.3)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,242,254,0.3)_1px,transparent_1px)] [transform:perspective(300px)_rotateX(60deg)] origin-bottom"></div>

    <!-- Pixel City Skyline Silhouette -->
    <div class="absolute bottom-0 inset-x-0 h-48 flex items-end justify-around opacity-90">
      <div class="w-16 h-40 bg-[#0d001a] border-t border-l border-[#ff00aa]/40"></div>
      <div class="w-12 h-28 bg-[#120024] border-t border-r border-[#00f0ff]/40"></div>
      <div class="w-20 h-44 bg-[#0a0014] border-t border-l border-[#ff00aa]/50 flex flex-col justify-around p-1">
        <div class="w-2 h-2 bg-[#00f0ff] opacity-80"></div>
        <div class="w-2 h-2 bg-[#ffea00] opacity-80"></div>
      </div>
      <div class="w-14 h-32 bg-[#120024] border-t border-r border-[#00f0ff]/40"></div>
      <div class="w-24 h-48 bg-[#090012] border-t border-x border-[#ff00aa]/60"></div>
      <div class="w-16 h-36 bg-[#15002b] border-t border-l border-[#00f0ff]/40"></div>
      <div class="w-20 h-42 bg-[#0d001a] border-t border-r border-[#ff00aa]/40"></div>
    </div>
  </div>

  <!-- LAYER 1: The Destructible Webpage Foreground Canvas -->
  <canvas id="page-canvas" class="absolute inset-0 w-full h-full z-10 cursor-crosshair"></canvas>

  <!-- LAYER 2: Physics Particles & Projectiles Canvas -->
  <canvas id="fx-canvas" class="absolute inset-0 w-full h-full z-20 pointer-events-none"></canvas>

  <!-- HUD: Top-Left Domain & Destruction Meter -->
  <div class="absolute top-4 left-4 z-30 flex items-center gap-3">
    <div class="px-4 py-2.5 bg-[#25093e]/90 backdrop-blur-md border border-[#ff659c]/60 rounded-2xl shadow-xl flex flex-col gap-1 min-w-[170px]">
      <div class="flex items-center justify-between text-xs font-mono">
        <span id="hud-domain" class="text-white font-black truncate max-w-[110px]">{initialTargetDomain}</span>
        <button id="btn-reopen-modal" class="text-[10px] text-[#00f0ff] hover:underline font-bold">Change ⚙️</button>
      </div>
      <div class="flex items-center justify-between gap-2">
        <div class="flex-1 h-2.5 bg-[#120420] rounded-full overflow-hidden p-0.5 border border-[#ff659c]/30">
          <div id="hud-bar" class="h-full bg-gradient-to-r from-[#ffea00] via-[#ff0077] to-[#00f0ff] rounded-full transition-all duration-150" style="width: 0%"></div>
        </div>
        <span id="hud-pct" class="text-xs font-mono font-black text-[#ff659c]">0%</span>
      </div>
    </div>
  </div>

  <!-- HUD: Top-Right Sound & Fullscreen Controls -->
  <div class="absolute top-4 right-4 z-30 flex items-center gap-2">
    <button
      id="btn-sound"
      class="px-3 py-1.5 bg-[#25093e]/90 hover:bg-[#ff4081]/30 backdrop-blur-md border border-[#ff659c]/50 rounded-xl text-xs font-mono text-white transition-colors"
      title="Toggle Audio"
    >
      🔊 SFX: ON
    </button>
    <button
      id="btn-repair"
      class="px-3 py-1.5 bg-[#25093e]/90 hover:bg-[#ff4081]/30 backdrop-blur-md border border-[#ff659c]/50 rounded-xl text-xs font-mono text-white transition-colors"
      title="Restore Webpage"
    >
      🔄 Repair
    </button>
  </div>

  <!-- HUD: Bottom-Center Floating Pixel Weapon Dock -->
  <div class="absolute bottom-4 inset-x-0 z-30 flex justify-center px-4 pointer-events-auto">
    <div class="flex items-center gap-1.5 sm:gap-2 p-2 bg-[#25093e]/95 backdrop-blur-md border-2 border-[#ff659c]/60 rounded-2xl shadow-[0_0_30px_rgba(255,64,129,0.4)] overflow-x-auto max-w-full">
      <!-- 1: Uzi -->
      <button class="weapon-slot active px-3 py-1.5 rounded-xl border border-[#ff0077] bg-[#ff0077]/30 text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="uzi">
        <span class="text-sm">🔫</span>
        <span class="hidden sm:inline">Uzi</span>
        <span class="text-[10px] opacity-60">1</span>
      </button>

      <!-- 2: Plasma Laser -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="laser">
        <span class="text-sm">⚡</span>
        <span class="hidden sm:inline">Laser</span>
        <span class="text-[10px] opacity-60">2</span>
      </button>

      <!-- 3: Shotgun -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="shotgun">
        <span class="text-sm">💥</span>
        <span class="hidden sm:inline">Shotgun</span>
        <span class="text-[10px] opacity-60">3</span>
      </button>

      <!-- 4: Heavy MG -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="gatling">
        <span class="text-sm">🌪️</span>
        <span class="hidden sm:inline">Gatling</span>
        <span class="text-[10px] opacity-60">4</span>
      </button>

      <!-- 5: Star Magic -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="magic">
        <span class="text-sm">⭐</span>
        <span class="hidden sm:inline">Magic</span>
        <span class="text-[10px] opacity-60">5</span>
      </button>

      <!-- 6: RPG Rocket -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="rocket">
        <span class="text-sm">🚀</span>
        <span class="hidden sm:inline">Rocket</span>
        <span class="text-[10px] opacity-60">6</span>
      </button>

      <!-- 7: Tactical Nuke -->
      <button class="weapon-slot px-3 py-1.5 rounded-xl border border-white/10 bg-[#120420]/80 text-[#cbd5e1] hover:text-white font-mono text-xs font-bold flex items-center gap-1.5 transition-all" data-id="nuke">
        <span class="text-sm">☢️</span>
        <span class="hidden sm:inline">Nuke</span>
        <span class="text-[10px] opacity-60">7</span>
      </button>

      <!-- RMB: Strawberry Grenade -->
      <div class="border-l border-white/20 pl-1.5 sm:pl-2">
        <button class="px-2.5 py-1.5 rounded-xl border border-[#ff0077]/40 bg-[#ff0077]/20 text-[#ffea00] font-mono text-xs font-black flex items-center gap-1" title="Right-Click anywhere to throw Strawberry Grenade!">
          <span>🍓 RMB</span>
        </button>
      </div>
    </div>
  </div>

  <!-- CENTER MODAL: Kawaii Cyber-Arcade Launcher Modal -->
  <div id="arcade-modal" class="absolute inset-0 z-40 bg-[#10021f]/75 backdrop-blur-md flex items-center justify-center p-4 transition-opacity duration-300">
    <div class="w-full max-w-lg bg-gradient-to-b from-[#3b0d61] to-[#1e0436] border-2 border-[#ff659c] rounded-3xl p-6 sm:p-8 shadow-[0_0_60px_rgba(255,101,156,0.6)] space-y-6 text-center">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#ff659c]/20 border border-[#ff659c]/40 rounded-full text-xs font-mono font-bold text-[#ff9ebb]">
        <span>✨</span>
        <span>Kawaii Cyber-Arcade Edition</span>
      </div>

      <!-- Gradient Pixel Title -->
      <h2 class="text-3xl sm:text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[#ff4081] via-[#ffea00] to-[#00f0ff] tracking-tight font-pixel">
        Destroy Any Website
      </h2>

      <p class="text-xs sm:text-sm text-[#e2d4f0] -mt-2">
        Type an address, smash everything with cute weapons! 🐾 ✨
      </p>

      <!-- URL Input Bar -->
      <div class="flex items-center bg-[#130324] border-2 border-[#ff659c]/60 rounded-2xl p-1.5 shadow-inner focus-within:border-[#00f0ff] transition-colors">
        <span class="text-xs font-mono text-[#ff659c] font-bold px-3 select-none">https://</span>
        <input
          type="text"
          id="modal-url-input"
          value="wikipedia.org"
          placeholder="e.g. google.com, school.edu..."
          class="w-full bg-transparent text-white text-xs sm:text-sm font-mono focus:outline-none placeholder:text-purple-400/50"
        />
        <button
          id="btn-modal-destroy"
          class="px-5 py-2.5 bg-gradient-to-r from-[#ff4081] to-[#ff0055] hover:scale-105 active:scale-95 text-white font-black text-xs sm:text-sm rounded-xl shadow-[0_0_20px_rgba(255,0,85,0.6)] font-mono transition-transform flex items-center gap-1 shrink-0"
        >
          <span>⚡ Destroy</span>
        </button>
      </div>

      <!-- Quick Try Chips -->
      <div class="space-y-2 text-left">
        <span class="text-[11px] font-mono text-purple-300 font-bold">Try presets:</span>
        <div class="flex flex-wrap gap-2">
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="wikipedia.org" data-theme="wiki">
            📄 Wikipedia
          </button>
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="google.com" data-theme="google">
            🔍 Google Search
          </button>
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="candyland.io" data-theme="candy">
            🍬 Candyland Demo
          </button>
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="schoolportal.edu" data-theme="school">
            🏫 School Portal
          </button>
          <button class="btn-quick-try px-3 py-1 bg-[#25093e] hover:bg-[#ff4081]/30 border border-[#ff659c]/40 text-xs font-mono text-white rounded-lg transition-all" data-url="reddit.com" data-theme="reddit">
            🐱 Reddit / Cute Cats
          </button>
        </div>
      </div>

      <!-- Controls Cheatsheet Footer in Modal -->
      <div class="pt-3 border-t border-purple-800/60 flex items-center justify-between text-[11px] font-mono text-purple-300">
        <div class="flex items-center gap-3">
          <span><kbd class="px-1.5 py-0.5 bg-[#130324] text-[#00f0ff] rounded">A</kbd> <kbd class="px-1.5 py-0.5 bg-[#130324] text-[#00f0ff] rounded">D</kbd> run</span>
          <span><kbd class="px-1.5 py-0.5 bg-[#130324] text-[#ffea00] rounded">Space</kbd> fly</span>
          <span>🖱️ Click shoot</span>
        </div>
        <span class="text-[#ff659c] font-bold">🍓 RMB grenade</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { sfx } from '../lib/sound';

  const container = document.getElementById('game-container');
  const pageCanvas = document.getElementById('page-canvas') as HTMLCanvasElement;
  const fxCanvas = document.getElementById('fx-canvas') as HTMLCanvasElement;
  const pageCtx = pageCanvas?.getContext('2d');
  const fxCtx = fxCanvas?.getContext('2d');

  const hudDomain = document.getElementById('hud-domain');
  const hudBar = document.getElementById('hud-bar');
  const hudPct = document.getElementById('hud-pct');
  const modal = document.getElementById('arcade-modal');
  const modalInput = document.getElementById('modal-url-input') as HTMLInputElement;

  let currentDomain = 'wikipedia.org';
  let currentTheme = 'wiki';
  let currentWeapon = 'uzi';
  let isMouseDown = false;
  let mouseX = 400;
  let mouseY = 300;
  let destructionPercent = 0;

  const player = {
    x: 400,
    y: 105,
    vx: 0,
    vy: 0,
    facing: 1,
    jetpack: false,
  };

  const keys: Record<string, boolean> = {};

  interface Projectile {
    x: number;
    y: number;
    startX: number;
    startY: number;
    targetX: number;
    targetY: number;
    totalDist: number;
    vx: number;
    vy: number;
    type: string;
    radius: number;
    life: number;
    color: string;
  }

  interface PaperShard {
    x: number;
    y: number;
    vx: number;
    vy: number;
    rot: number;
    vRot: number;
    size: number;
    color: string;
    life: number;
    maxLife: number;
  }

  const projectiles: Projectile[] = [];
  const paperShards: PaperShard[] = [];

  let activeLiveImg: HTMLImageElement | null = null;
  let isLoadingLive = false;

  function loadLiveWebsiteScreenshot(urlOrDomain: string) {
    let fullUrl = urlOrDomain.trim();
    if (!fullUrl.startsWith('http://') && !fullUrl.startsWith('https://')) {
      fullUrl = 'https://' + fullUrl;
    }

    try {
      const parsed = new URL(fullUrl);
      currentDomain = parsed.hostname;
    } catch {
      currentDomain = urlOrDomain;
    }

    isLoadingLive = true;
    renderScanningHUD(currentDomain);

    const img = new Image();
    img.crossOrigin = 'anonymous';

    // Direct live visual capture proxy (Microlink API)
    const proxyUrl = `https://api.microlink.io/?url=${encodeURIComponent(fullUrl)}&screenshot=true&embed=screenshot.url`;

    img.onload = () => {
      isLoadingLive = false;
      activeLiveImg = img;
      renderActiveCanvas();
    };

    img.onerror = () => {
      // Fallback to stylized high-fidelity procedural template if CORS or offline
      isLoadingLive = false;
      activeLiveImg = null;
      renderProceduralFallback(currentDomain);
    };

    img.src = proxyUrl;
  }

  function renderScanningHUD(domain: string) {
    if (!pageCtx || !pageCanvas) return;
    const w = pageCanvas.width;
    const h = pageCanvas.height;

    pageCtx.globalCompositeOperation = 'source-over';
    pageCtx.fillStyle = '#0f051d';
    pageCtx.fillRect(0, 0, w, h);

    // Glowing Radar Grid
    pageCtx.strokeStyle = 'rgba(0, 240, 255, 0.25)';
    pageCtx.lineWidth = 1;
    for (let x = 0; x < w; x += 40) {
      pageCtx.beginPath();
      pageCtx.moveTo(x, 0);
      pageCtx.lineTo(x, h);
      pageCtx.stroke();
    }
    for (let y = 0; y < h; y += 40) {
      pageCtx.beginPath();
      pageCtx.moveTo(0, y);
      pageCtx.lineTo(w, y);
      pageCtx.stroke();
    }

    // Scanning target text
    pageCtx.fillStyle = '#00F0FF';
    pageCtx.font = 'bold 20px monospace';
    pageCtx.textAlign = 'center';
    pageCtx.fillText(`📡 INTERCEPTING LIVE FEED: ${domain.toUpperCase()}`, w / 2, h / 2 - 20);

    pageCtx.fillStyle = '#FF659C';
    pageCtx.font = '13px monospace';
    pageCtx.fillText('Rendering real-world DOM structure & visual layers...', w / 2, h / 2 + 15);
    pageCtx.textAlign = 'left';
  }

  function renderActiveCanvas() {
    if (!pageCtx || !pageCanvas) return;
    const w = pageCanvas.width;
    const h = pageCanvas.height;

    pageCtx.globalCompositeOperation = 'source-over';
    pageCtx.fillStyle = '#FFFFFF';
    pageCtx.fillRect(0, 0, w, h);

    if (activeLiveImg) {
      // Draw the real live website screenshot fitted to canvas
      pageCtx.drawImage(activeLiveImg, 0, 0, w, h);
    } else {
      renderProceduralFallback(currentDomain);
    }

    player.x = w / 2;
    player.y = 105;
    player.vx = 0;
    player.vy = 0;

    destructionPercent = 0;
    updateHUD();
  }

  function renderProceduralFallback(domain: string) {
    if (!pageCtx || !pageCanvas) return;
    const w = pageCanvas.width;
    const h = pageCanvas.height;

    pageCtx.globalCompositeOperation = 'source-over';
    pageCtx.fillStyle = '#FFFFFF';
    pageCtx.fillRect(0, 0, w, h);

    if (domain.includes('google')) {
      pageCtx.font = 'bold 48px sans-serif';
      pageCtx.fillStyle = '#4285F4';
      pageCtx.fillText('G', w / 2 - 70, 150);
      pageCtx.fillStyle = '#EA4335';
      pageCtx.fillText('o', w / 2 - 35, 150);
      pageCtx.fillStyle = '#FBBC05';
      pageCtx.fillText('o', w / 2 - 5, 150);
      pageCtx.fillStyle = '#4285F4';
      pageCtx.fillText('g', w / 2 + 25, 150);
      pageCtx.fillStyle = '#34A853';
      pageCtx.fillText('l', w / 2 + 55, 150);
      pageCtx.fillStyle = '#EA4335';
      pageCtx.fillText('e', w / 2 + 70, 150);

      pageCtx.fillStyle = '#FFFFFF';
      pageCtx.beginPath();
      pageCtx.roundRect(w / 2 - 200, 190, 400, 44, 22);
      pageCtx.fill();
      pageCtx.strokeStyle = '#DFE1E5';
      pageCtx.lineWidth = 1;
      pageCtx.stroke();

      pageCtx.fillStyle = '#70757A';
      pageCtx.font = '14px sans-serif';
      pageCtx.fillText('🔍 Search Google or type a URL...', w / 2 - 170, 218);

      pageCtx.fillStyle = '#F8F9FA';
      pageCtx.fillRect(w / 2 - 140, 260, 130, 36);
      pageCtx.fillRect(w / 2 + 10, 260, 140, 36);
      pageCtx.fillStyle = '#3C4043';
      pageCtx.font = '13px sans-serif';
      pageCtx.fillText('Google Search', w / 2 - 120, 283);
      pageCtx.fillText("I'm Feeling Lucky", w / 2 + 25, 283);
    } else {
      // Modern Clean Web Template
      pageCtx.fillStyle = '#0f172a';
      pageCtx.fillRect(0, 0, w, 56);
      pageCtx.fillStyle = '#FFFFFF';
      pageCtx.font = 'bold 16px sans-serif';
      pageCtx.fillText(`🌐 https://${domain}`, 24, 34);

      pageCtx.fillStyle = '#38bdf8';
      pageCtx.fillRect(w - 140, 14, 116, 28);
      pageCtx.fillStyle = '#0f172a';
      pageCtx.font = 'bold 12px sans-serif';
      pageCtx.fillText('Sign In / Account', w - 130, 32);

      pageCtx.fillStyle = '#1e293b';
      pageCtx.font = 'bold 32px sans-serif';
      pageCtx.fillText(`Welcome to ${domain}`, 40, 120);

      pageCtx.fillStyle = '#64748b';
      pageCtx.font = '14px sans-serif';
      pageCtx.fillText(`This is the live rendered sandbox for ${domain}. You can destroy any element on this page!`, 40, 155);

      pageCtx.fillStyle = '#f8fafc';
      pageCtx.fillRect(40, 190, w - 80, 280);
      pageCtx.strokeStyle = '#e2e8f0';
      pageCtx.lineWidth = 1;
      pageCtx.strokeRect(40, 190, w - 80, 280);

      pageCtx.fillStyle = '#0284c7';
      pageCtx.fillRect(60, 220, 160, 40);
      pageCtx.fillStyle = '#FFFFFF';
      pageCtx.font = 'bold 14px sans-serif';
      pageCtx.fillText('Primary Action', 85, 245);

      pageCtx.fillStyle = '#334155';
      pageCtx.font = '14px sans-serif';
      pageCtx.fillText('• High-Performance Enterprise Architecture & API Integration', 60, 300);
      pageCtx.fillText('• Real-Time Cloud Data Synchronizer & Secure Gateways', 60, 335);
      pageCtx.fillText('• Interactive 2D Destruction Physics Sandbox Online', 60, 370);
    }
  }

  function resizeCanvases() {
    if (!container || !pageCanvas || !fxCanvas) return;
    const w = container.clientWidth;
    const h = container.clientHeight;
    pageCanvas.width = w;
    pageCanvas.height = h;
    fxCanvas.width = w;
    fxCanvas.height = h;
    renderActiveCanvas();
  }

  window.addEventListener('resize', resizeCanvases);

  // Dynamic Organic Blast Shapes for Different Weapons
  function punchBlastHole(x: number, y: number, baseRadius: number, shape: 'jagged' | 'star' | 'pellet' | 'laser' | 'huge' = 'jagged') {
    if (!pageCtx) return;

    pageCtx.globalCompositeOperation = 'destination-out';
    pageCtx.beginPath();

    if (shape === 'star') {
      // 5-Point Star Punch Hole (Magic Wand)
      const points = 5;
      const outerR = baseRadius * 1.3;
      const innerR = baseRadius * 0.5;
      for (let i = 0; i < points * 2; i++) {
        const r = i % 2 === 0 ? outerR : innerR;
        const angle = (i / (points * 2)) * Math.PI * 2 - Math.PI / 2;
        const px = x + Math.cos(angle) * r;
        const py = y + Math.sin(angle) * r;
        if (i === 0) pageCtx.moveTo(px, py);
        else pageCtx.lineTo(px, py);
      }
    } else if (shape === 'huge') {
      // Massive Jagged Star-Burst Crater (Rocket / Nuke / Grenade)
      const points = 16;
      for (let i = 0; i < points; i++) {
        const angle = (i / points) * Math.PI * 2;
        const r = baseRadius * (0.65 + Math.random() * 0.7);
        const px = x + Math.cos(angle) * r;
        const py = y + Math.sin(angle) * r;
        if (i === 0) pageCtx.moveTo(px, py);
        else pageCtx.lineTo(px, py);
      }
    } else if (shape === 'pellet') {
      // Shotgun single pellet bite
      const points = 8;
      for (let i = 0; i < points; i++) {
        const angle = (i / points) * Math.PI * 2;
        const r = baseRadius * (0.7 + Math.random() * 0.6);
        const px = x + Math.cos(angle) * r;
        const py = y + Math.sin(angle) * r;
        if (i === 0) pageCtx.moveTo(px, py);
        else pageCtx.lineTo(px, py);
      }
    } else {
      // Standard Organic Jagged Bite Hole (Uzi / Gatling)
      const points = 10;
      for (let i = 0; i < points; i++) {
        const angle = (i / points) * Math.PI * 2;
        const r = baseRadius * (0.75 + Math.random() * 0.5);
        const px = x + Math.cos(angle) * r;
        const py = y + Math.sin(angle) * r;
        if (i === 0) pageCtx.moveTo(px, py);
        else pageCtx.lineTo(px, py);
      }
    }

    pageCtx.closePath();
    pageCtx.fill();

    spawnPaperShards(x, y, baseRadius);

    destructionPercent = Math.min(100, destructionPercent + Math.max(1, Math.round(baseRadius / 8)));
    updateHUD();
  }

  function spawnPaperShards(x: number, y: number, radius: number) {
    const count = Math.min(30, Math.max(4, Math.floor(radius * 0.7)));
    for (let i = 0; i < count; i++) {
      const angle = Math.random() * Math.PI * 2;
      const speed = Math.random() * 8 + 2;
      paperShards.push({
        x: x + (Math.random() - 0.5) * radius,
        y: y + (Math.random() - 0.5) * radius,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed - 3,
        rot: Math.random() * Math.PI * 2,
        vRot: (Math.random() - 0.5) * 0.4,
        size: Math.random() * 12 + 4,
        color: Math.random() > 0.3 ? '#FFFFFF' : '#CBD5E1',
        life: 0,
        maxLife: Math.random() * 45 + 30,
      });
    }
  }

  function updateHUD() {
    if (hudBar) hudBar.style.width = `${destructionPercent}%`;
    if (hudPct) hudPct.textContent = `${destructionPercent}%`;
    if (hudDomain) hudDomain.textContent = currentDomain;
  }

  let lastShotTime = 0;
  function shootWeapon() {
    const now = performance.now();
    const gunX = player.x + player.facing * 16;
    const gunY = player.y - 12;
    const targetX = mouseX;
    const targetY = mouseY;
    const angle = Math.atan2(targetY - gunY, targetX - gunX);

    if (currentWeapon === 'uzi') {
      if (now - lastShotTime < 70) return;
      lastShotTime = now;
      sfx.playGunshot();

      // Instant Precision Hit at cursor with tiny scatter
      const hitX = targetX + (Math.random() - 0.5) * 8;
      const hitY = targetY + (Math.random() - 0.5) * 8;
      punchBlastHole(hitX, hitY, Math.random() * 6 + 10, 'jagged');

      // Tracer bullet line from gun to target
      projectiles.push({
        x: gunX,
        y: gunY,
        startX: gunX,
        startY: gunY,
        targetX: hitX,
        targetY: hitY,
        totalDist: Math.hypot(hitX - gunX, hitY - gunY),
        vx: (hitX - gunX) / 3,
        vy: (hitY - gunY) / 3,
        type: 'tracer',
        radius: 2.5,
        life: 0,
        color: '#FFEA00',
      });
    } else if (currentWeapon === 'shotgun') {
      if (now - lastShotTime < 300) return;
      lastShotTime = now;
      sfx.playShotgun();

      // True Multi-Pellet Scatter Cluster directly around cursor!
      for (let i = 0; i < 7; i++) {
        const scatterDist = Math.random() * 28 + 4;
        const scatterAngle = Math.random() * Math.PI * 2;
        const pelletX = targetX + Math.cos(scatterAngle) * scatterDist;
        const pelletY = targetY + Math.sin(scatterAngle) * scatterDist;
        
        punchBlastHole(pelletX, pelletY, Math.random() * 6 + 8, 'pellet');

        // Tracer
        projectiles.push({
          x: gunX,
          y: gunY,
          startX: gunX,
          startY: gunY,
          targetX: pelletX,
          targetY: pelletY,
          totalDist: Math.hypot(pelletX - gunX, pelletY - gunY),
          vx: (pelletX - gunX) / 3,
          vy: (pelletY - gunY) / 3,
          type: 'tracer',
          radius: 3,
          life: 0,
          color: '#FF3366',
        });
      }
    } else if (currentWeapon === 'laser') {
      sfx.playLaser();
      // Continuous Laser Slicing directly on cursor
      punchBlastHole(targetX, targetY, 16, 'laser');

      // Laser Beam Line
      projectiles.push({
        x: gunX,
        y: gunY,
        startX: gunX,
        startY: gunY,
        targetX: targetX,
        targetY: targetY,
        totalDist: Math.hypot(targetX - gunX, targetY - gunY),
        vx: targetX,
        vy: targetY,
        type: 'laser_beam',
        radius: 4,
        life: 0,
        color: '#00F0FF',
      });
    } else if (currentWeapon === 'gatling') {
      if (now - lastShotTime < 40) return;
      lastShotTime = now;
      sfx.playGunshot();

      const hitX = targetX + (Math.random() - 0.5) * 14;
      const hitY = targetY + (Math.random() - 0.5) * 14;
      punchBlastHole(hitX, hitY, Math.random() * 5 + 9, 'jagged');

      projectiles.push({
        x: gunX,
        y: gunY,
        startX: gunX,
        startY: gunY,
        targetX: hitX,
        targetY: hitY,
        totalDist: Math.hypot(hitX - gunX, hitY - gunY),
        vx: (hitX - gunX) / 2,
        vy: (hitY - gunY) / 2,
        type: 'tracer',
        radius: 3,
        life: 0,
        color: '#FF9900',
      });
    } else if (currentWeapon === 'magic') {
      if (now - lastShotTime < 150) return;
      lastShotTime = now;
      sfx.playMagic();

      punchBlastHole(targetX, targetY, 26, 'star');

      projectiles.push({
        x: targetX,
        y: targetY,
        startX: targetX,
        startY: targetY,
        targetX: targetX,
        targetY: targetY,
        totalDist: 0,
        vx: (Math.random() - 0.5) * 4,
        vy: -Math.random() * 4 - 2,
        type: 'star',
        radius: 6,
        life: 0,
        color: '#00F0FF',
      });
    } else if (currentWeapon === 'rocket') {
      if (now - lastShotTime < 400) return;
      lastShotTime = now;
      sfx.playExplosion();

      // Precision Rocket ballistic flight directly to (targetX, targetY)
      const dist = Math.hypot(targetX - gunX, targetY - gunY);
      const speed = 18;
      projectiles.push({
        x: gunX,
        y: gunY,
        startX: gunX,
        startY: gunY,
        targetX: targetX,
        targetY: targetY,
        totalDist: Math.max(1, dist),
        vx: dist > 0 ? ((targetX - gunX) / dist) * speed : 0,
        vy: dist > 0 ? ((targetY - gunY) / dist) * speed : 0,
        type: 'rocket',
        radius: 8,
        life: 0,
        color: '#FF0055',
      });
    } else if (currentWeapon === 'nuke') {
      if (now - lastShotTime < 2000) return;
      lastShotTime = now;
      sfx.playNuke();

      // Direct nuke epicenter right on mouse click
      punchBlastHole(targetX, targetY, 140, 'huge');

      for (let i = 0; i < 8; i++) {
        setTimeout(() => {
          if (!pageCanvas) return;
          const rx = targetX + (Math.random() - 0.5) * 350;
          const ry = targetY + (Math.random() - 0.5) * 250;
          punchBlastHole(rx, ry, 120, 'huge');
        }, i * 60);
      }
    }
  }

  function throwGrenade() {
    sfx.playBounce();
    const gunX = player.x + player.facing * 16;
    const gunY = player.y - 12;
    const targetX = mouseX;
    const targetY = mouseY;
    const dist = Math.hypot(targetX - gunX, targetY - gunY);
    const timeFrames = Math.max(20, Math.min(50, dist / 12));
    const gravity = 0.4;
    
    // Precise parabolic toss to land on targetX, targetY
    const vx = (targetX - gunX) / timeFrames;
    const vy = (targetY - gunY - 0.5 * gravity * timeFrames * timeFrames) / timeFrames;

    projectiles.push({
      x: gunX,
      y: gunY,
      startX: gunX,
      startY: gunY,
      targetX: targetX,
      targetY: targetY,
      totalDist: dist,
      vx: vx,
      vy: vy,
      type: 'grenade',
      radius: 7,
      life: 0,
      color: '#FF0077',
    });
  }

  let walkCycle = 0;
  function drawPlayer(ctx: CanvasRenderingContext2D) {
    ctx.save();
    ctx.translate(player.x, player.y);
    if (player.facing === -1) ctx.scale(-1, 1);

    const isMoving = Math.abs(player.vx) > 0.5;
    if (isMoving) walkCycle += 0.25;

    // Jetpack animated flames if hovering
    if (player.jetpack) {
      ctx.fillStyle = '#00F0FF';
      ctx.fillRect(-16, 12, 6, Math.random() * 16 + 8);
      ctx.fillStyle = '#FFEA00';
      ctx.fillRect(-14, 14, 4, Math.random() * 10 + 4);
    }

    // Shadow on paper
    ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
    ctx.beginPath();
    ctx.ellipse(0, 24, 14, 4, 0, 0, Math.PI * 2);
    ctx.fill();

    // Body: Neon Orange Anime Outfit
    ctx.fillStyle = '#FF6B00';
    ctx.fillRect(-12, -14, 24, 24);
    ctx.fillStyle = '#FF9E00';
    ctx.fillRect(-8, -10, 16, 16);

    // Jetpack Booster Backpack
    ctx.fillStyle = '#25093E';
    ctx.fillRect(-16, -10, 6, 18);
    ctx.fillStyle = '#00F0FF';
    ctx.fillRect(-16, -6, 2, 8);

    // Head
    ctx.fillStyle = '#FFE5D9';
    ctx.fillRect(-11, -32, 22, 20);

    // Long Kawaii Ears
    ctx.fillStyle = '#FF6B00';
    ctx.fillRect(-12, -44, 7, 14);
    ctx.fillRect(5, -44, 7, 14);
    ctx.fillStyle = '#FF4081';
    ctx.fillRect(-10, -42, 3, 10);
    ctx.fillRect(7, -42, 3, 10);

    // Big Anime Eyes
    ctx.fillStyle = '#1A0033';
    ctx.fillRect(2, -26, 4, 8);
    ctx.fillRect(-7, -26, 4, 8);
    // Eye sparkle
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(3, -25, 2, 3);
    ctx.fillRect(-6, -25, 2, 3);

    // Cute Cheerful Blush
    ctx.fillStyle = '#FF4081';
    ctx.fillRect(4, -18, 4, 3);
    ctx.fillRect(-9, -18, 4, 3);

    // Animated Running Legs
    const legOffset1 = isMoving ? Math.sin(walkCycle) * 6 : 0;
    const legOffset2 = isMoving ? -Math.sin(walkCycle) * 6 : 0;

    ctx.fillStyle = '#1A0033';
    ctx.fillRect(-8 + legOffset1, 10, 6, 12);
    ctx.fillRect(2 + legOffset2, 10, 6, 12);
    ctx.fillStyle = '#FF4081';
    ctx.fillRect(-10 + legOffset1, 18, 8, 5);
    ctx.fillRect(2 + legOffset2, 18, 8, 5);

    // Pixel Weapon in Hand
    ctx.fillStyle = '#334155';
    ctx.fillRect(6, -6, 16, 7);
    ctx.fillStyle = '#FF4081';
    ctx.fillRect(8, -8, 6, 3);
    ctx.fillStyle = '#FFEA00';
    ctx.fillRect(18, -8, 5, 4);

    ctx.restore();
  }

  function gameLoop() {
    if (fxCtx && fxCanvas) {
      fxCtx.clearRect(0, 0, fxCanvas.width, fxCanvas.height);

      // Multi-Input Check: Keyboard WASD / Arrows + Mouse Auto-Hop
      const keyLeft = keys['KeyA'] || keys['ArrowLeft'] || keys['a'] || keys['A'];
      const keyRight = keys['KeyD'] || keys['ArrowRight'] || keys['d'] || keys['D'];
      const keyUp = keys['Space'] || keys['KeyW'] || keys['ArrowUp'] || keys['w'] || keys['W'];
      const keyDown = keys['KeyS'] || keys['ArrowDown'] || keys['s'] || keys['S'];

      if (keyLeft) {
        player.vx = -4.5;
        player.facing = -1;
      } else if (keyRight) {
        player.vx = 4.5;
        player.facing = 1;
      } else if (isMouseDown) {
        // Smooth mouse auto-follow when firing
        const dx = mouseX - player.x;
        if (Math.abs(dx) > 35) {
          player.vx = Math.sign(dx) * 3.8;
          player.facing = Math.sign(dx) as 1 | -1;
        } else {
          player.vx *= 0.75;
          player.facing = (mouseX >= player.x ? 1 : -1) as 1 | -1;
        }
      } else {
        player.vx *= 0.8;
      }

      if (keyUp) {
        player.vy = -6;
        player.jetpack = true;
      } else {
        player.jetpack = false;
        player.vy += 0.35;
      }

      player.x += player.vx;
      player.y += player.vy;

      if (!keyDown && player.vy >= 0) {
        if (player.y >= 95 && player.y <= 114) {
          player.y = 105;
          player.vy = 0;
        } else if (player.y >= 225 && player.y <= 244) {
          player.y = 235;
          player.vy = 0;
        }
      }

      if (player.x < 30) player.x = 30;
      if (player.x > fxCanvas.width - 30) player.x = fxCanvas.width - 30;
      if (player.y > fxCanvas.height - 40) {
        player.y = fxCanvas.height - 40;
        player.vy = 0;
      }
      if (player.y < 40) player.y = 40;

      if (isMouseDown && !modal?.classList.contains('flex')) {
        shootWeapon();
      }

      for (let i = projectiles.length - 1; i >= 0; i--) {
        const p = projectiles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life++;

        if (p.type === 'grenade') {
          p.vy += 0.3;
          if (p.y >= fxCanvas.height - 30) {
            p.y = fxCanvas.height - 30;
            p.vy = -p.vy * 0.6;
            p.vx *= 0.8;
            sfx.playBounce();
          }

          fxCtx.font = '16px serif';
          fxCtx.fillText('🍓', p.x - 8, p.y + 6);

          const distToTarget = Math.hypot(p.x - p.targetX, p.y - p.targetY);
          if (distToTarget < 20 || p.life > 45) {
            sfx.playExplosion();
            punchBlastHole(p.targetX, p.targetY, 75, 'huge');
            projectiles.splice(i, 1);
            continue;
          }
        } else if (p.type === 'rocket') {
          // Draw Rocket Body & Jet Flame
          fxCtx.save();
          const angle = Math.atan2(p.vy, p.vx);
          fxCtx.translate(p.x, p.y);
          fxCtx.rotate(angle);

          // Rocket Body
          fxCtx.fillStyle = '#FF0055';
          fxCtx.fillRect(-10, -4, 16, 8);
          // Rocket Nosecone
          fxCtx.fillStyle = '#FFEA00';
          fxCtx.beginPath();
          fxCtx.moveTo(6, -4);
          fxCtx.lineTo(14, 0);
          fxCtx.lineTo(6, 4);
          fxCtx.closePath();
          fxCtx.fill();
          // Rocket Wings
          fxCtx.fillStyle = '#00F0FF';
          fxCtx.fillRect(-10, -7, 4, 14);

          // Animated Thruster Flame
          fxCtx.fillStyle = Math.random() > 0.5 ? '#FF9900' : '#FFEA00';
          fxCtx.fillRect(-16, -3, 6, 6);
          fxCtx.restore();

          // Spawn smoke particles behind rocket
          if (Math.random() > 0.3) {
            paperShards.push({
              x: p.x - p.vx * 0.4,
              y: p.y - p.vy * 0.4,
              vx: (Math.random() - 0.5) * 1.5,
              vy: (Math.random() - 0.5) * 1.5,
              rot: Math.random() * Math.PI,
              vRot: 0.1,
              size: Math.random() * 4 + 2,
              color: 'rgba(255, 120, 120, 0.7)',
              life: 0,
              maxLife: 15,
            });
          }

          const distTraveled = Math.hypot(p.x - p.startX, p.y - p.startY);
          const distToTarget = Math.hypot(p.x - p.targetX, p.y - p.targetY);

          // Explode PRECISELY on mouse target coordinates
          if (distTraveled >= p.totalDist || distToTarget <= 20 || p.life > 50 || p.x < 0 || p.x > fxCanvas.width || p.y < 0 || p.y > fxCanvas.height) {
            sfx.playExplosion();
            punchBlastHole(p.targetX, p.targetY, 70, 'huge');
            projectiles.splice(i, 1);
            continue;
          }
        } else if (p.type === 'star') {
          fxCtx.font = '14px serif';
          fxCtx.fillText('⭐', p.x - 6, p.y + 5);
          if (p.life > 15) {
            punchBlastHole(p.targetX, p.targetY, 35, 'star');
            projectiles.splice(i, 1);
            continue;
          }
        } else {
          fxCtx.fillStyle = p.color;
          fxCtx.beginPath();
          fxCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          fxCtx.fill();

          if (p.life > 10) {
            punchBlastHole(p.targetX, p.targetY, 14, 'jagged');
            projectiles.splice(i, 1);
            continue;
          }
        }
      }

      for (let i = paperShards.length - 1; i >= 0; i--) {
        const s = paperShards[i];
        s.x += s.vx;
        s.y += s.vy;
        s.vy += 0.25;
        s.rot += s.vRot;
        s.life++;

        fxCtx.save();
        fxCtx.translate(s.x, s.y);
        fxCtx.rotate(s.rot);
        fxCtx.fillStyle = s.color;
        fxCtx.fillRect(-s.size / 2, -s.size / 2, s.size, s.size * 0.7);
        fxCtx.restore();

        if (s.life >= s.maxLife || s.y > fxCanvas.height + 20) {
          paperShards.splice(i, 1);
        }
      }

      drawPlayer(fxCtx);
    }
    requestAnimationFrame(gameLoop);
  }

  window.addEventListener('keydown', (e) => {
    keys[e.code] = true;

    const weaponMap: Record<string, string> = {
      'Digit1': 'uzi',
      'Digit2': 'laser',
      'Digit3': 'shotgun',
      'Digit4': 'gatling',
      'Digit5': 'magic',
      'Digit6': 'rocket',
      'Digit7': 'nuke',
    };
    if (weaponMap[e.code]) {
      selectWeapon(weaponMap[e.code]);
    }
  });

  window.addEventListener('keyup', (e) => {
    keys[e.code] = false;
  });

  container?.addEventListener('mousemove', (e) => {
    const rect = container.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
  });

  container?.addEventListener('mousedown', (e) => {
    if ((e.target as HTMLElement).closest('#arcade-modal') || (e.target as HTMLElement).closest('.weapon-slot') || (e.target as HTMLElement).closest('button')) {
      return;
    }
    if (e.button === 0) {
      isMouseDown = true;
      shootWeapon();
    } else if (e.button === 2) {
      e.preventDefault();
      throwGrenade();
    }
  });

  window.addEventListener('mouseup', () => {
    isMouseDown = false;
  });

  container?.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    throwGrenade();
  });

  function selectWeapon(id: string) {
    currentWeapon = id;
    document.querySelectorAll('.weapon-slot').forEach((btn) => {
      const bId = btn.getAttribute('data-id');
      if (bId === id) {
        btn.classList.add('border-[#ff0077]', 'bg-[#ff0077]/30', 'text-white');
        btn.classList.remove('border-white/10', 'bg-[#120420]/80', 'text-[#cbd5e1]');
      } else {
        btn.classList.remove('border-[#ff0077]', 'bg-[#ff0077]/30', 'text-white');
        btn.classList.add('border-white/10', 'bg-[#120420]/80', 'text-[#cbd5e1]');
      }
    });
  }

  document.querySelectorAll('.weapon-slot').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id') || 'uzi';
      selectWeapon(id);
    });
  });

  document.getElementById('btn-modal-destroy')?.addEventListener('click', () => {
    const inputVal = modalInput?.value?.trim() || 'wikipedia.org';
    loadLiveWebsiteScreenshot(inputVal);
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  document.querySelectorAll('.btn-quick-try').forEach((chip) => {
    chip.addEventListener('click', () => {
      const url = chip.getAttribute('data-url') || 'wikipedia.org';
      if (modalInput) modalInput.value = url;
      loadLiveWebsiteScreenshot(url);
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    });
  });

  document.getElementById('btn-reopen-modal')?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  });

  document.getElementById('btn-repair')?.addEventListener('click', () => {
    renderActiveCanvas();
  });

  document.getElementById('btn-sound')?.addEventListener('click', () => {
    const isMuted = sfx.toggleMute();
    const btn = document.getElementById('btn-sound');
    if (btn) btn.textContent = isMuted ? '🔇 SFX: OFF' : '🔊 SFX: ON';
  });

  // Initial load
  resizeCanvases();
  loadLiveWebsiteScreenshot('wikipedia.org');
  gameLoop();
</script>
