---
import { WEAPONS } from '../data/weapons';
interface Props { initialTargetUrl?: string; initialTargetDomain?: string; }
const { initialTargetUrl = 'https://wikipedia.org', initialTargetDomain = 'wikipedia.org' } = Astro.props;
---
<section id="game-container" class="arcade" tabindex="0" aria-label="Website destruction game" data-initial-url={initialTargetUrl} data-initial-domain={initialTargetDomain}>
  <span id="game-viewport"></span>
  <canvas id="game-canvas" aria-label="Destructible webpage. Use A and D to move, S to descend, Space to fly, and click to shoot."></canvas>
  <div class="stage-vignette"></div>
  <div class="game-hud" id="game-hud" hidden>
    <div class="target-meter">
      <div class="target-line"><span class="live-dot"></span><span id="hud-domain">{initialTargetDomain}</span><button id="btn-reopen-modal" aria-label="Change website">↗</button></div>
      <div class="meter-label"><span>DESTRUCTION</span><strong id="hud-pct">0%</strong></div>
      <div class="meter-track"><div id="hud-bar"></div></div>
    </div>
    <div class="game-actions">
      <button id="btn-sound" title="Toggle sound" aria-label="Mute sound">♫</button>
      <button id="btn-repair" title="Restart this page" aria-label="Restart this page">↻</button>
      <button id="btn-snapshot" title="Save demolition certificate" class="text-action" aria-label="Share score">Share score</button>
      <button id="btn-friend-challenge" class="text-action">Challenge a friend</button>
      <button id="btn-fullscreen" title="Fullscreen" aria-label="Fullscreen">⛶</button>
      <button id="btn-pause" title="Pause (Esc)" aria-label="Pause">Ⅱ</button>
    </div>
    <div class="travel-info"><div class="travel-heading"><strong id="hud-depth">Screen 1 / 4</strong><button data-key="KeyA" aria-label="Hold to move left" title="Move left (A / left arrow)">←</button><button data-key="KeyD" aria-label="Hold to move right" title="Move right (D / right arrow)">→</button><button data-key="KeyS" aria-label="Hold to descend" title="Hold to descend (S)">↓</button><button data-key="Space" aria-label="Hold to fly up" title="Hold to fly up (Space)">↑</button></div><span>A / D or ← / → move · G / right click throw</span><span>Wheel: browse page · 1–8: weapons</span><button id="btn-follow-player" class="follow-player" hidden>Back to character</button><span id="travel-hint">Hold S ↓ to descend · Hold Space ↑ to fly</span></div>
    <div class="session-info"><span id="session-time">00:00</span><span class="session-separator">/</span><span id="hud-pieces">0 pieces scattered</span></div>
  </div>
  <div id="challenge-status" class="challenge-status" role="status" hidden></div>
  <div id="game-status" class="game-status" role="status" hidden></div>
  <div class="launcher overlay" id="arcade-modal">
    <div class="launch-card">
      <div class="eyebrow"><span class="live-dot"></span> YOUR BROWSER. YOUR PLAYGROUND.</div>
      <div class="launch-emblem" aria-hidden="true">✦</div>
      <h2>Break the internet.<br /><span>Just for fun.</span></h2>
      <p class="launch-description">Turn a website into your own little demolition playground.<br class="desktop-break" /> Pick a weapon. Take a leap. Make a beautiful mess.</p>
      <form id="target-form" class="url-form">
        <label for="modal-url-input" class="url-prefix">https://</label>
        <input id="modal-url-input" type="text" value={initialTargetDomain} autocomplete="off" spellcheck="false" aria-label="Website address" placeholder="Enter a website" />
        <button type="submit" id="btn-modal-destroy">Let's destroy <span>↗</span></button>
      </form>
      <p id="url-error" class="url-error" role="alert" hidden></p>
      <div class="demo-label"><span></span> OR JUMP STRAIGHT IN <span></span></div>
      <div class="demo-list">
        <button class="btn-quick-try" data-target="demo:candy"><span>🍭</span> Candyland <small>Sweet destruction</small></button>
        <button class="btn-quick-try" data-target="demo:cats"><span>🐈</span> Cat Club <small>Perfect little chaos</small></button>
        <button class="btn-quick-try" data-target="demo:space"><span>🪐</span> Outer Space <small>Out of this world</small></button>
      </div>
      <div class="launcher-controls"><span><kbd>A</kbd><kbd>D</kbd> move</span><span><kbd>SPACE</kbd> jump / fly</span><span><kbd>S</kbd> descend</span><span><kbd>CLICK</kbd> shoot</span></div>
      <button id="btn-back-game" class="back-game" hidden>← Back to your game</button>
    </div>
  </div>
  <div id="loading-modal" class="overlay loading-overlay" hidden>
    <div class="loading-card"><div class="loading-spinner"></div><h2>Building your playground</h2><p id="loading-label">Preparing the webpage…</p><button id="btn-cancel-load">Cancel and edit URL</button></div>
  </div>
  <div id="pause-modal" class="overlay pause-overlay" hidden>
    <div class="pause-card"><span class="eyebrow">TAKE A BREATHER</span><h2 id="pause-title">Chaos can wait.</h2><p id="pause-description">Your playground is right where you left it.</p><button id="btn-resume" class="primary-action">Back to the chaos →</button><div class="pause-secondary"><button id="btn-restart">Start over</button><button id="btn-new-target">New website</button></div><div class="pause-help"><kbd>A</kbd> <kbd>D</kbd> move · <kbd>Space</kbd> jump / hold to fly<br /><kbd>S</kbd> drop · Right click grenade · <kbd>1–8</kbd> weapons</div></div>
  </div>
  <div id="cert-modal" class="overlay pause-overlay" hidden>
    <div class="certificate-card"><button id="btn-close-cert" class="close-cert" aria-label="Close certificate">×</button><span class="eyebrow">A BEAUTIFUL MESS, CERTIFIED.</span><h2>Your demolition report.</h2><canvas id="cert-canvas"></canvas><div class="pause-secondary"><button id="btn-download-cert" class="primary-action">Download image ↓</button><button id="btn-share-link">Challenge a friend</button><button id="btn-share-x">Share to X</button></div><p id="certificate-status" role="status"></p><label class="share-label" for="challenge-link">Friend challenge link</label><input id="challenge-link" class="share-link" readonly aria-label="Friend challenge link" /><p class="share-note">Friends play separately. Live webpages may change between visits; demos use the same layout.</p></div>
  </div>
  <div id="weapon-dock" class="weapon-area" hidden>
    <div class="weapon-caption"><span id="weapon-name">Pistol</span><span id="weapon-hint">Hold to fire · 1–8 to switch</span></div>
    <div class="weapon-dock">
      {WEAPONS.map((w, i) => <button class="weapon-slot" data-id={w.id} aria-label={w.name} aria-pressed={i === 0} title={`${w.name} · ${w.shortcut}`}><span class="weapon-number">{i + 1}</span><svg viewBox="0 0 64 32" aria-hidden="true" class={`weapon-art weapon-${w.id}`}><g fill="currentColor"><path d={i === 7 ? 'M27 3h10v5h-10zM22 10h20v4h4v14H18V14h4z' : i === 4 ? 'M9 23L43 7l3 5L12 28zM46 0l4 6 8-2-3 7 5 5-8 1-4 7-3-8-7-2 6-5z' : i === 6 ? 'M5 8h47v14H5zM50 5h9v20h-9zM17 22h9v8h-9z' : i === 5 ? 'M7 10h41V5l13 11-13 11v-6H7zM14 21h9v9h-9z' : i === 2 ? 'M4 10h54v6H4zM18 16h28v7H18zM8 16h10v13H8z' : i === 3 ? 'M7 8h43v16H7zM49 11h12v4H49zM49 19h12v4H49zM18 24h9v7h-9z' : i === 1 ? 'M9 7h41v13H9zM46 11h13v5H46zM18 20h8v11h-8zM34 20h7v10h-7z' : 'M10 6h41v11H29v13H17V17h-7zM49 8h10v6H49z'} /></g><path d="M12 11h21v3H12z" fill="#fff" opacity=".65" /></svg><span class="weapon-label">{w.id === 'grenade' ? 'Grenade' : w.name}</span></button>)}
    </div>
  </div>
  <div id="touch-controls" class="touch-controls" hidden><button data-key="KeyA" aria-label="Move left">←</button><button data-key="KeyD" aria-label="Move right">→</button><button data-key="KeyS" aria-label="Descend through webpage">↓</button><button data-key="Space" aria-label="Jump and fly">↑</button></div>
</section>
<style>
.game-actions .text-action { width: auto; padding: 0 12px; font: bold 12px Arial; color: #ffd1e2; }
.follow-player { border-radius: 5px; background: #684568; padding: 6px 8px; text-align: left; color: white; }
@media (max-width: 700px) { .game-actions { max-width: 155px; flex-wrap: wrap; justify-content: flex-end; } .game-actions .text-action { font-size: 10px; padding: 0 8px; } }

.challenge-status { position: absolute; bottom: 135px; left: 50%; transform: translateX(-50%); max-width: 90%; width: max-content; padding: 9px 14px; border-radius: 8px; background: #21182ef2; color: #ffd9a6; font: 12px Arial; pointer-events: none; }
.share-label { display: block; font-size: 12px; text-align: left; margin: 12px 0 6px; }
.share-link { width: 100%; padding: 10px; background: #171326; border: 1px solid #68516e; border-radius: 8px; color: white; font-size: 12px; }
.share-note { color: #bfaec9; font-size: 12px; }

.arcade {
  position: relative;
  width: 100%;
  height: calc(100svh - 155px);
  min-height: 520px;
  max-height: 1100px;
  overflow: hidden;
  border: 1px solid #615077;
  border-radius: 16px;
  background: #19152d;
  isolation: isolate;
  outline: none;
  color: #fff;
  font-family: Arial, Helvetica, sans-serif;
  scroll-margin-top: 140px;
}
.arcade:fullscreen {
  height: 100vh;
  max-height: none;
  border: 0;
  border-radius: 0;
}
#game-canvas {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
  cursor: crosshair;
}
[hidden] {
  display: none !important;
}
.stage-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  box-shadow: inset 0 0 90px #08081845;
  border-radius: inherit;
}
.game-hud {
  position: absolute;
  inset: 14px 24px;
  pointer-events: none;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.game-hud button {
  pointer-events: auto;
}
.target-meter {
  width: 200px;
  padding: 8px 12px;
  background: #171326e8;
  border: 1px solid #ffffff22;
  border-radius: 12px;
  box-shadow: 0 8px 24px #0002;
}
.target-line {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #ded7eb;
}
.target-line > span:nth-child(2) {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 1;
}
.target-line button {
  color: #c8b8e0;
  font-size: 18px;
}
.live-dot {
  width: 6px;
  height: 6px;
  display: inline-block;
  background: #b4f1bd;
  border-radius: 50%;
  box-shadow: 0 0 10px #b4f1bd55;
  flex-shrink: 0;
}
.meter-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 5px 0;
  font-size: 9px;
  letter-spacing: 1.5px;
  color: #a29aae;
}
.meter-label strong {
  font-size: 20px;
  letter-spacing: -0.5px;
  color: #f9b7c7;
}
.meter-track {
  height: 4px;
  background: #ffffff10;
  border-radius: 4px;
  overflow: hidden;
}
#hud-bar {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, #e572a3, #ffd9a6);
  transition: width 0.15s;
}
.game-actions {
  display: flex;
  gap: 7px;
}
.game-actions button {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #171326dc;
  border: 1px solid #ffffff20;
  color: #ded3e9;
  font-size: 20px;
  transition: 0.15s;
}
.game-actions button:hover {
  background: #6d3d74;
  transform: translateY(-2px);
}
.travel-info {
  position: absolute; bottom: 0; left: 0; width: 250px; display: grid; gap: 5px;
  padding: 8px 10px; border-radius: 8px; background: #171326e8; font: 10px monospace; color: #ded7eb;
}
.travel-info strong { color: #f9b7c7; flex: 1; }
.travel-heading { display: flex; align-items: center; gap: 8px; }
.travel-heading button { width: 30px; height: 28px; border-radius: 5px; background: #ffffff18; font: 18px Arial; touch-action: none; }
.session-info {
  position: absolute;
  right: 0;
  top: 49px;
  color: #c0adca;
  font: 10px monospace;
  display: flex;
  gap: 10px;
}
.session-separator {
  opacity: 0.35;
}
.game-status {
  position: absolute;
  top: 210px;
  left: 24px;
  max-width: 360px;
  font-size: 11px;
  color: #dacbe3;
  background: #221b38e6;
  border-radius: 7px;
  padding: 8px 12px;
  pointer-events: none;
}
.overlay {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px;
  background: #100b2269;
  backdrop-filter: blur(4px);
}
.launch-card {
  position: relative;
  width: 600px;
  max-width: 100%;
  text-align: center;
  background: linear-gradient(145deg, #29203bed, #191328f5);
  border: 1px solid #b79dcc40;
  border-radius: 22px;
  padding: 30px 35px 25px;
  box-shadow:
    0 30px 100px #05011170,
    inset 0 1px #ffffff0d;
}
.eyebrow {
  font: 9px monospace;
  letter-spacing: 2px;
  color: #c2accf;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.launch-emblem {
  font-size: 40px;
  color: #ffc59e;
  line-height: 1;
  margin: 17px 0 12px;
  text-shadow: 0 0 35px #fa769b55;
}
.launch-card h2 {
  font-size: clamp(32px, 3.6vw, 49px);
  line-height: 1.05;
  font-weight: 800;
  letter-spacing: -2px;
  margin: 0;
}
.launch-card h2 span {
  background: linear-gradient(90deg, #f8afc3, #fbd5a4);
  color: transparent;
  background-clip: text;
}
.launch-description {
  font-size: 12px;
  line-height: 1.8;
  color: #b7a9c3;
  margin: 18px 0 22px;
}
.url-form {
  display: flex;
  align-items: center;
  background: #110e1e;
  border: 1px solid #76617f;
  border-radius: 10px;
  padding: 5px 5px 5px 14px;
  box-shadow: 0 0 0 3px #a27bac0a;
}
.url-form:focus-within {
  border-color: #e6a6c8;
}
.url-prefix {
  font: 12px monospace;
  color: #9f839f;
}
.url-form input {
  background: none;
  border: 0;
  outline: 0;
  color: #eee2f1;
  width: 100%;
  min-width: 0;
  font: 12px monospace;
  padding: 10px 3px;
}
.url-form button,
.primary-action {
  background: linear-gradient(135deg, #f3a8bd, #ed81a7);
  border: 1px solid #ffc6d2;
  border-radius: 7px;
  color: #38192f;
  font-size: 12px;
  font-weight: 700;
  padding: 12px 17px;
  white-space: nowrap;
  box-shadow: 0 3px 15px #ef7ca025;
}
.url-form button span {
  margin-left: 12px;
}
.url-error {
  color: #ffb3a8;
  font-size: 12px;
  margin-top: 10px;
}
.demo-label {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 22px 0 14px;
  font: 8px monospace;
  letter-spacing: 1.5px;
  color: #84768e;
}
.demo-label span {
  height: 1px;
  background: #ffffff0d;
  flex: 1;
}
.demo-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}
.btn-quick-try {
  border: 1px solid #ffffff16;
  border-radius: 10px;
  background: #ffffff04;
  padding: 12px 4px;
  color: #e6ddea;
  font-size: 11px;
  transition: 0.2s;
}
.btn-quick-try:hover {
  background: #b879a222;
  border-color: #eab2d277;
  transform: translateY(-3px);
}
.btn-quick-try > span {
  display: block;
  font-size: 24px;
  margin-bottom: 7px;
}
.btn-quick-try small {
  display: block;
  font-size: 8px;
  color: #95869f;
  margin-top: 5px;
}
.launcher-controls {
  display: flex;
  justify-content: center;
  gap: 17px;
  margin-top: 23px;
  font-size: 9px;
  color: #a091ac;
}
.launcher-controls span {
  display: flex;
  align-items: center;
  gap: 4px;
}
kbd {
  font: 9px monospace;
  background: #ffffff0a;
  border: 1px solid #ffffff18;
  border-radius: 4px;
  padding: 3px 5px;
  color: #cdbed8;
}
.back-game {
  color: #e7b2c8;
  font-size: 11px;
  margin-top: 15px;
}
.weapon-area {
  position: absolute;
  bottom: 18px;
  left: 50%;
  transform: translateX(-50%);
  max-width: calc(100% - 32px);
  z-index: 2;
}
.weapon-caption {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 4px 9px;
  color: #f3d5e6;
  font-size: 11px;
  text-shadow: 0 2px 5px #000;
}
#weapon-hint {
  color: #b8a6be;
  font-size: 9px;
}
.weapon-dock {
  display: flex;
  gap: 5px;
  padding: 7px;
  background: #161125ed;
  border: 1px solid #b891b745;
  border-radius: 14px;
  box-shadow: 0 8px 35px #0005;
}
.weapon-slot {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: 78px;
  height: 69px;
  border-radius: 8px;
  border: 1px solid #ffffff0b;
  background: #ffffff03;
  color: #c5aecb;
  transition: 0.15s;
}
.weapon-slot:hover {
  background: #ffffff0a;
}
.weapon-slot[aria-pressed="true"] {
  background: #73436755;
  border-color: #e89ec9;
  color: #ffc3d9;
  box-shadow: inset 0 0 18px #f88bab0d;
}
.weapon-number {
  position: absolute;
  top: 4px;
  left: 6px;
  font: 8px monospace;
  color: #8d7b9b;
}
.weapon-art {
  width: 47px;
  height: 27px;
  image-rendering: pixelated;
  margin-top: 6px;
}
.weapon-label {
  font-size: 8px;
  color: #bbacc7;
}
.weapon-slot[aria-pressed="true"] .weapon-label {
  color: #ffe1ef;
}
.weapon-rocket {
  color: #e5af86;
}
.weapon-magic {
  color: #f0d58d;
}
.weapon-grenade {
  color: #e390a7;
}
.weapon-uzi {
  color: #8fcbb3;
}
.pause-overlay,
.loading-overlay {
  background: #100c24b8;
  backdrop-filter: blur(9px);
}
.pause-card,
.loading-card,
.certificate-card {
  position: relative;
  width: 430px;
  max-width: 100%;
  padding: 35px;
  background: #261c36;
  border: 1px solid #80638b;
  border-radius: 18px;
  text-align: center;
  box-shadow: 0 30px 90px #0005;
}
.pause-card h2,
.loading-card h2,
.certificate-card h2 {
  font-size: 29px;
  font-weight: 800;
  letter-spacing: -1px;
  margin: 20px 0 10px;
}
.pause-card p,
.loading-card p {
  font-size: 12px;
  color: #ae9eba;
  margin-bottom: 24px;
}
.pause-card > .primary-action {
  width: 100%;
}
.pause-secondary {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 20px;
  font-size: 12px;
  color: #dabedb;
}
.pause-help {
  border-top: 1px solid #ffffff12;
  margin-top: 24px;
  padding-top: 20px;
  font-size: 10px;
  line-height: 2.3;
  color: #a995b3;
}
.loading-spinner {
  height: 28px;
  width: 28px;
  border: 2px solid #ffffff18;
  border-top-color: #f1b3cb;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto;
}
.loading-card > button {
  font-size: 12px;
  color: #efb0cf;
}
.certificate-card {
  max-height: 100%;
  overflow-y: auto;
  width: 680px;
  padding: 25px;
}
.certificate-card canvas {
  width: 100%;
  height: min(28svh, 240px);
  object-fit: contain;
  margin-top: 15px;
  border: 1px solid #ffffff25;
  border-radius: 8px;
}
.certificate-card p {
  font-size: 11px;
  color: #ceb7d9;
  margin-top: 10px;
}
.close-cert {
  position: absolute;
  right: 16px;
  top: 8px;
  font-size: 24px;
  color: #c3afcb;
}
.touch-controls {
  position: absolute;
  bottom: 130px;
  left: 18px;
  gap: 8px;
}
.touch-controls button {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: #221633cc;
  border: 1px solid #b58cab;
  color: #fff;
  touch-action: none;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
@media (max-height: 720px) and (min-width: 701px) {
  .arcade {
    min-height: 490px;
  }
  .launch-card {
    padding: 20px 30px;
  }
  .launch-emblem {
    display: none;
  }
  .launch-card h2 {
    margin-top: 18px;
    font-size: 40px;
  }
  .launch-description {
    margin: 13px 0 16px;
  }
  .demo-label {
    margin: 16px 0 10px;
  }
  .launcher-controls {
    margin-top: 16px;
  }
}
@media (max-width: 700px) {
  .arcade {
    height: calc(100svh - 80px);
    min-height: 560px;
    border-radius: 10px;
  }
  .game-hud {
    inset: 12px;
  }
  .target-meter {
    width: 173px;
    padding: 10px 12px;
  }
  .game-actions {
    gap: 4px;
  }
