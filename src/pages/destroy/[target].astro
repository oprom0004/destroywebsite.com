---
import Layout from '../../layouts/Layout.astro';
import DestructionGame from '../../components/DestructionGame.astro';
import GEOQuickAnswer from '../../components/GEOQuickAnswer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { TARGET_SITES, type TargetSite } from '../../data/targets';

export async function getStaticPaths() {
  return TARGET_SITES.map((site) => ({
    params: { target: site.slug },
    props: { site },
  }));
}

interface Props {
  site: TargetSite;
}

const { site } = Astro.props;

const pageTitle = `Destroy ${site.name}: Smash & Obliterate Online Game`;
const pageDescription = `Play the free online 2D physics simulation to destroy ${site.name} (${site.url}). Use lasers, rockets, and sledgehammers to obliterate ${site.elementsCount} webpage elements.`;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: `Destroy ${site.name}`,
    description: `A 2D physics demolition sandbox simulation of ${site.name}.`,
    genre: ['Physics Sandbox', 'Arcade', 'Action', 'Stress Relief'],
    gamePlatform: ['Web Browser', 'PC', 'Mac', 'Chromebook', 'Mobile'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://destroywebsite.com/' },
      { '@type': 'ListItem', position: 2, name: 'Targets', item: 'https://destroywebsite.com/targets/' },
      { '@type': 'ListItem', position: 3, name: `Destroy ${site.name}`, item: `https://destroywebsite.com/destroy/${site.slug}/` },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono text-destruct-dim" aria-label="Breadcrumb">
      <a href="/" class="hover:text-neon-cyan">Home</a>
      <span>/</span>
      <a href="/targets/" class="hover:text-neon-cyan">Targets</a>
      <span>/</span>
      <span class="text-white">{site.name}</span>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2">
        <span class="px-3 py-1 bg-neon-cyan/20 text-neon-cyan border border-neon-cyan/40 text-xs font-mono font-bold rounded-full uppercase tracking-wider">
          Target: {site.category} · {site.difficulty} Difficulty
        </span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Destroy <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-pink to-neon-cyan">{site.name}</span>
      </h1>
      <p class="text-sm sm:text-base text-destruct-muted">
        {site.description}
      </p>
    </div>

    <!-- Interactive Game Stage Preloaded with this Target -->
    <DestructionGame initialTargetSlug={site.slug} />

    <!-- GEO Quick Summary -->
    <GEOQuickAnswer
      question={`How does the Destroy ${site.name} simulation work?`}
      directAnswer={`This interactive sandbox creates a local 2D physics replica of ${site.name} (${site.url}) containing ${site.elementsCount} interactive layout elements. Players can test weapons and trigger chain reactions in their browser. The real ${site.url} servers are not touched or harmed.`}
      bulletPoints={[
        `Target Domain: ${site.url}`,
        `Destructible Blocks: ${site.elementsCount} simulated HTML elements`,
        `Difficulty Tier: ${site.difficulty}`,
        `100% Client-Side Safe Sandbox`,
      ]}
    />

    <!-- FAQ -->
    <FAQSection />
  </div>
</Layout>
