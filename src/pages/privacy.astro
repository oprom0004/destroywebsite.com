---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Privacy Policy: Destroy Website';
const pageDescription = 'Our privacy policy outlines our data practices, cookie policy, and strict zero-logging stance for Destroy Website.';
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">
    <nav class="flex items-center gap-2 text-xs font-mono text-destruct-dim">
      <a href="/" class="hover:text-neon-cyan">Home</a>
      <span>/</span>
      <span class="text-white">Privacy Policy</span>
    </nav>

    <div class="text-center space-y-2">
      <h1 class="text-3xl font-black text-white">Privacy Policy</h1>
      <p class="text-xs font-mono text-destruct-dim">Last Updated: October 2026</p>
    </div>

    <div class="bg-arcade-card border border-arcade-border rounded-3xl p-6 sm:p-10 space-y-6 text-xs sm:text-sm text-destruct-muted leading-relaxed">
      <section class="space-y-2">
        <h2 class="text-base font-bold text-white">1. Information We Do Not Collect</h2>
        <p>
          We do not require user accounts, email logins, or personal passwords. The URLs you enter into our sandbox are processed strictly inside your local web browser session and are never sent to or stored on our servers.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base font-bold text-white">2. Analytics & Cookies</h2>
        <p>
          We may use privacy-compliant, anonymized web analytics (such as Google Analytics or Cloudflare Web Analytics) to measure total page views, country traffic, and browser compatibility. These metrics contain no personally identifiable information.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base font-bold text-white">3. Third-Party Links & Sandboxes</h2>
        <p>
          When you enter third-party URLs to generate a simulation, we encourage you to review those respective websites' privacy policies independently.
        </p>
      </section>
    </div>
  </div>
</Layout>
