---
import Layout from '../layouts/Layout.astro';
import FAQSection from '../components/FAQSection.astro';

const pageTitle = 'How to Play Destroy Website: Controls, Shortcuts & Weapon Tips';
const pageDescription = 'Master Destroy Website with our comprehensive guide: keyboard shortcut numbers (1-7), mouse crosshair aim, touch gestures, combo scoring, and 100% wipeout tactics.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to Destroy Any Website in Your Browser',
    description: 'A 4-step beginner guide to loading custom URLs and using weapons in the Destroy Website demolition sandbox.',
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Enter Target URL or Choose Preset',
        text: 'Type any web address into the search input bar at the top or click one of our preset buttons (like Google or Wikipedia).',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Select Your Weapon of Choice',
        text: 'Choose from 8 weapons in the top armory ribbon or press keyboard keys 1 through 7 to switch instantaneously.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Aim and Fire at Webpage Elements',
        text: 'Click or drag across HTML elements, navigation bars, and buttons to trigger physics explosions, lasers, and shockwaves.',
      },
      {
        '@type': 'HowToStep',
        position: 4,
        name: 'Achieve 100% Obliteration',
        text: 'Chain hits together to build combo multipliers and wipe out 100% of the page elements to unlock the victory badge.',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://destroywebsite.com/' },
      { '@type': 'ListItem', position: 2, name: 'How to Play', item: 'https://destroywebsite.com/how-to-play/' },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono text-destruct-dim" aria-label="Breadcrumb">
      <a href="/" class="hover:text-neon-cyan">Home</a>
      <span>/</span>
      <span class="text-white">How to Play</span>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        How to Play <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-pink to-neon-yellow">Destroy Website</span>
      </h1>
      <p class="text-sm sm:text-base text-destruct-muted max-w-xl mx-auto">
        Complete keyboard shortcuts, aim controls, combo mechanics, and high-score strategies.
      </p>
    </div>

    <!-- Quick Controls Cheatsheet Table -->
    <section class="bg-arcade-card border border-arcade-border rounded-3xl p-6 sm:p-8 space-y-6">
      <h2 class="text-xl font-bold text-white flex items-center gap-2 border-b border-arcade-border pb-3">
        <span>⌨️</span>
        <span>Keyboard & Mouse Shortcuts</span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-mono text-xs">
        <div class="flex items-center justify-between p-3 bg-arcade-darkest rounded-xl border border-arcade-border">
          <span class="text-destruct-muted">Left Click / Tap</span>
          <span class="font-bold text-neon-cyan">Attack / Fire Weapon</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-arcade-darkest rounded-xl border border-arcade-border">
          <span class="text-destruct-muted">Key <kbd class="px-1.5 py-0.5 bg-arcade-card rounded text-white">1</kbd></span>
          <span class="font-bold text-neon-yellow">🔨 Cyber Sledgehammer</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-arcade-darkest rounded-xl border border-arcade-border">
          <span class="text-destruct-muted">Key <kbd class="px-1.5 py-0.5 bg-arcade-card rounded text-white">2</kbd></span>
          <span class="font-bold text-neon-cyan">⚡ Plasma Laser</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-arcade-darkest rounded-xl border border-arcade-border">
          <span class="text-destruct-muted">Key <kbd class="px-1.5 py-0.5 bg-arcade-card rounded text-white">3</kbd></span>
          <span class="font-bold text-neon-pink">🚀 RPG Rocket</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-arcade-darkest rounded-xl border border-arcade-border">
          <span class="text-destruct-muted">Key <kbd class="px-1.5 py-0.5 bg-arcade-card rounded text-white">4</kbd></span>
          <span class="font-bold text-neon-red">🔫 Vulcan Gatling</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-arcade-darkest rounded-xl border border-arcade-border">
          <span class="text-destruct-muted">Key <kbd class="px-1.5 py-0.5 bg-arcade-card rounded text-white">5</kbd></span>
          <span class="font-bold text-orange-400">🔥 Flamethrower</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-arcade-darkest rounded-xl border border-arcade-border">
          <span class="text-destruct-muted">Key <kbd class="px-1.5 py-0.5 bg-arcade-card rounded text-white">6</kbd></span>
          <span class="font-bold text-purple-400">🕳️ Singularity Black Hole</span>
        </div>
        <div class="flex items-center justify-between p-3 bg-arcade-darkest rounded-xl border border-arcade-border">
          <span class="text-destruct-muted">Key <kbd class="px-1.5 py-0.5 bg-arcade-card rounded text-white">7</kbd></span>
          <span class="font-bold text-neon-green">☢️ Tactical Nuke</span>
        </div>
      </div>
    </section>

    <!-- Step by Step Walkthrough -->
    <section class="bg-arcade-card border border-arcade-border rounded-3xl p-6 sm:p-8 space-y-6">
      <h2 class="text-xl font-bold text-white flex items-center gap-2 border-b border-arcade-border pb-3">
        <span>🏆</span>
        <span>Pro Demolition Tactics</span>
      </h2>

      <div class="space-y-4 text-xs sm:text-sm text-destruct-muted leading-relaxed">
        <div class="p-4 bg-arcade-darkest rounded-2xl border border-arcade-border space-y-1.5">
          <h3 class="font-bold text-white text-base">1. Build Up Massive Combo Multipliers</h3>
          <p>
            Hitting multiple webpage containers in rapid succession (within 1.5 seconds) triggers a <strong>Combo Streak</strong>. Chaining together 10+ hits boosts visual particle intensity and unlocks secret audio cues.
          </p>
        </div>

        <div class="p-4 bg-arcade-darkest rounded-2xl border border-arcade-border space-y-1.5">
          <h3 class="font-bold text-white text-base">2. Laser & Rocket Synergies</h3>
          <p>
            Use the <strong>Plasma Laser Beam (Key 2)</strong> to carve deep fissures across dense paragraph cards, then finish the cluster off with an <strong>RPG Rocket (Key 3)</strong> to send hundreds of pixel fragments flying simultaneously.
          </p>
        </div>

        <div class="p-4 bg-arcade-darkest rounded-2xl border border-arcade-border space-y-1.5">
          <h3 class="font-bold text-white text-base">3. Instant Reset & Benchmark</h3>
          <p>
            Want to test how fast you can 100% obliterate a site? Hit the <strong>Reset Button (🔄)</strong> to instantly reconstruct the target DOM tree and start your speedrun timer!
          </p>
        </div>
      </div>
    </section>

    <!-- Bottom Action CTA -->
    <div class="p-8 bg-gradient-to-r from-neon-pink/20 via-neon-purple/20 to-neon-cyan/20 border-2 border-neon-cyan/40 rounded-3xl text-center space-y-4">
      <h3 class="text-2xl font-black text-white">Ready to Put Your Skills to the Test?</h3>
      <p class="text-xs sm:text-sm text-destruct-muted max-w-md mx-auto">
        Jump back into the sandbox and demolish your first website in seconds.
      </p>
      <a
        href="/#game-viewport"
        class="inline-block px-6 py-3 bg-neon-cyan text-arcade-darkest font-black text-xs sm:text-sm rounded-xl shadow-[0_0_20px_rgba(5,217,232,0.5)] hover:scale-105 transition-transform uppercase font-mono"
      >
        🎮 Launch Sandbox Arena
      </a>
    </div>
  </div>
</Layout>
