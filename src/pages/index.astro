---
import Layout from '../layouts/Layout.astro';
import DestructionGame from '../components/DestructionGame.astro';
import GEOQuickAnswer from '../components/GEOQuickAnswer.astro';
import WeaponCard from '../components/WeaponCard.astro';
import TargetCard from '../components/TargetCard.astro';
import FAQSection from '../components/FAQSection.astro';
import BookmarkletBox from '../components/BookmarkletBox.astro';
import { WEAPONS } from '../data/weapons';
import { TARGET_SITES } from '../data/targets';

const pageTitle = 'Destroy Any Website – Free Browser Game & Friend Challenges';
const pageDescription = 'Play a free webpage destruction game with eight weapons. Move, fly, throw grenades, explore long pages and share timed score challenges with friends.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Destroy Any Website',
    url: 'https://destroywebsite.com/',
    description: 'Free online browser physics sandbox to smash and destroy any webpage.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Destroy Any Website - Kawaii Cyber-Arcade',
    alternateName: ['Destroy Website', 'Smash The Web', 'Kick The Page'],
    genre: ['Physics Sandbox', 'Arcade', 'Action', 'Stress Relief'],
    gamePlatform: ['Web Browser', 'PC', 'Mac', 'Chromebook', 'Mobile'],
    applicationCategory: 'Game',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <header class="px-5 py-2 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-lg sm:text-xl font-bold text-white">Destroy Any Website</h1>
    <p class="text-xs text-destruct-muted">Smash webpages with 8 weapons. Share your score and challenge a friend.</p>
  </header>
  <div class="px-2 sm:px-3 pt-2 pb-3">
    <DestructionGame />
  </div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-12">
    <!-- GEO / Google AI Overview Key Fact Block -->
    <GEOQuickAnswer />

    <section class="space-y-3" aria-labelledby="friend-challenges">
      <h2 id="friend-challenges" class="text-2xl font-bold text-white">How do friend challenges work?</h2>
      <p class="text-destruct-muted">Destroy part of a page, then choose “Challenge a friend” in the game. Your link includes the target, destruction percentage and time limit. Your friend opens it and accepts the challenge to start their timer. Reach the score before time runs out to win.</p>
      <p class="text-sm text-destruct-muted">These are separate score challenges, not live multiplayer rooms. Demo pages have a consistent layout; live website previews may change. Share score also lets you download a demolition report or open an X post.</p>
    </section>
    <!-- Popular Destructible Targets -->
    <section class="space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-4 border-b border-arcade-border pb-3">
        <div>
          <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
            <span>🎯</span>
            <span>Popular Target Presets</span>
          </h2>
          <p class="text-xs sm:text-sm text-destruct-muted">
            Choose a target domain, or play an instant local demo above.
          </p>
        </div>
        <a href="/targets/" class="text-xs font-mono font-bold text-neon-cyan hover:underline flex items-center gap-1">
          <span>View All Targets</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {TARGET_SITES.slice(0, 3).map((target) => (
          <TargetCard target={target} />
        ))}
      </div>
    </section>

    <!-- Weapons Arsenal Grid Preview -->
    <section class="space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-4 border-b border-arcade-border pb-3">
        <div>
          <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
            <span>💣</span>
            <span>Destructive Weapon Armory</span>
          </h2>
          <p class="text-xs sm:text-sm text-destruct-muted">
            Eight selectable weapons. Switch with 1–8; use the mouse wheel to explore the page.
          </p>
        </div>
        <a href="/weapons/" class="text-xs font-mono font-bold text-neon-pink hover:underline flex items-center gap-1">
          <span>Explore All Weapons & Stats</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {WEAPONS.slice(0, 4).map((w) => (
          <WeaponCard weapon={w} />
        ))}
      </div>
    </section>

    <!-- Viral Challenge & Heritage Section -->
    <section class="bg-gradient-to-br from-arcade-card via-arcade-darkest to-arcade-card border border-arcade-border rounded-3xl p-6 sm:p-10 space-y-6">
      <div class="space-y-2">
        <span class="px-3 py-1 bg-neon-yellow/20 text-neon-yellow border border-neon-yellow/40 text-xs font-mono font-bold rounded-full uppercase tracking-wider">
          🔥 Viral Social Challenge
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          As Seen on TikTok, YouTube Shorts & Reddit
        </h2>
        <p class="text-xs sm:text-sm text-destruct-muted leading-relaxed">
          The classic 10-second stress-relief video formula: <em>"Type in your school portal, former boss's website, or annoying paywall, and blast it with a tactical nuke!"</em>
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono text-xs">
        <div class="p-4 bg-arcade-darkest/80 rounded-2xl border border-arcade-border space-y-1.5">
          <span class="text-neon-pink font-bold text-sm block">1. Pick Your Nemesis Site</span>
          <p class="text-destruct-dim">Input any live URL or select from our high-difficulty presets like School Portals or Social Feeds.</p>
        </div>
        <div class="p-4 bg-arcade-darkest/80 rounded-2xl border border-arcade-border space-y-1.5">
          <span class="text-neon-cyan font-bold text-sm block">2. Unleash 8 Weapons</span>
          <p class="text-destruct-dim">Cut with lasers, fire rockets, and throw grenades. Progress tracks the page area you actually destroy.</p>
        </div>
        <div class="p-4 bg-arcade-darkest/80 rounded-2xl border border-arcade-border space-y-1.5">
          <span class="text-neon-green font-bold text-sm block">3. 100% Instant Catharsis</span>
          <p class="text-destruct-dim">Record your screen, reach 100% obliteration, and share your speedrun demolition clips with friends.</p>
        </div>
      </div>
    </section>

    <!-- Draggable Bookmarklet Generator -->
    <BookmarkletBox />

    <!-- Structured FAQ Accordion -->
    <FAQSection />
  </div>
</Layout>
