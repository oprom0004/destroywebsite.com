---
import Layout from '../layouts/Layout.astro';
import DestructionGame from '../components/DestructionGame.astro';
import GEOQuickAnswer from '../components/GEOQuickAnswer.astro';
import WeaponCard from '../components/WeaponCard.astro';
import TargetCard from '../components/TargetCard.astro';
import FAQSection from '../components/FAQSection.astro';
import BookmarkletBox from '../components/BookmarkletBox.astro';
import { WEAPONS } from '../data/weapons';
import { TARGET_SITES } from '../data/targets';

const pageTitle = 'Destroy Website: Play Free 2D Physics Web Demolition Game';
const pageDescription = 'Type any URL and turn any website into a destructible 2D physics battleground! Use lasers, RPG rockets, sledgehammers, and tactical nukes to smash any page. 100% free, safe & in-browser.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Destroy Website',
    url: 'https://destroywebsite.com/',
    description: 'Free online browser physics sandbox to smash and destroy any webpage.',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://destroywebsite.com/?target={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'Destroy Website - 2D Webpage Demolition Sandbox',
    alternateName: ['Destroy Any Website', 'Smash The Web', 'Kick The Page'],
    genre: ['Physics Sandbox', 'Arcade', 'Action', 'Stress Relief'],
    gamePlatform: ['Web Browser', 'PC', 'Mac', 'Chromebook', 'Mobile'],
    applicationCategory: 'Game',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-16">
    <!-- Hero Header -->
    <section class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2">
        <span class="px-3.5 py-1 bg-neon-pink/15 text-neon-pink border border-neon-pink/30 text-xs font-black rounded-full font-mono uppercase tracking-wider shadow-[0_0_15px_rgba(255,42,109,0.3)]">
          💥 #1 Anti-Stress Web Sandbox · Free In Browser
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight">
        Turn Any Webpage into a <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-pink via-neon-yellow to-neon-cyan">Destructible Arena</span>
      </h1>

      <p class="text-sm sm:text-base text-destruct-muted leading-relaxed">
        Tired of annoying popups, school homework deadlines, or slow sites? Type any URL below, grab a laser or rocket launcher, and pulverize every element into dust!
      </p>
    </section>

    <!-- Main Interactive Game Sandbox -->
    <DestructionGame />

    <!-- GEO / Google AI Overview Key Fact Block -->
    <GEOQuickAnswer />

    <!-- Popular Destructible Targets -->
    <section class="space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-4 border-b border-arcade-border pb-3">
        <div>
          <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
            <span>🎯</span>
            <span>Popular Target Presets</span>
          </h2>
          <p class="text-xs sm:text-sm text-destruct-muted">
            Instant 1-click destruction simulations with custom DOM layouts.
          </p>
        </div>
        <a href="/targets/" class="text-xs font-mono font-bold text-neon-cyan hover:underline flex items-center gap-1">
          <span>View All 15+ Targets</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {TARGET_SITES.slice(0, 3).map((target) => (
          <TargetCard target={target} />
        ))}
      </div>
    </section>

    <!-- Weapons Arsenal Grid Preview -->
    <section class="space-y-6">
      <div class="flex items-center justify-between flex-wrap gap-4 border-b border-arcade-border pb-3">
        <div>
          <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
            <span>💣</span>
            <span>Destructive Weapon Armory</span>
          </h2>
          <p class="text-xs sm:text-sm text-destruct-muted">
            From kinetic sledgehammers to apocalyptic tactical nukes and gravity black holes.
          </p>
        </div>
        <a href="/weapons/" class="text-xs font-mono font-bold text-neon-pink hover:underline flex items-center gap-1">
          <span>Explore All Weapons & Stats</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {WEAPONS.slice(0, 4).map((w) => (
          <WeaponCard weapon={w} />
        ))}
      </div>
    </section>

    <!-- Draggable Bookmarklet Generator -->
    <BookmarkletBox />

    <!-- Structured FAQ Accordion -->
    <FAQSection />
  </div>
</Layout>
