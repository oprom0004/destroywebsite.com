---
import Layout from '../../layouts/Layout.astro';
import TargetCard from '../../components/TargetCard.astro';
import { TARGET_SITES } from '../../data/targets';

const pageTitle = 'Destructible Website Targets: Google, Wikipedia, School Portal & More';
const pageDescription = 'Choose from popular pre-configured destructible website targets: smash the Google homepage, blast Wikipedia articles, or demolish annoying school portals in 1-click.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Destructible Website Target Directory',
    description: 'A curated catalog of popular preset websites ready for instant 2D physics demolition.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://destroywebsite.com/' },
      { '@type': 'ListItem', position: 2, name: 'Targets', item: 'https://destroywebsite.com/targets/' },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono text-destruct-dim" aria-label="Breadcrumb">
      <a href="/" class="hover:text-neon-cyan">Home</a>
      <span>/</span>
      <span class="text-white">Preset Targets</span>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3 max-w-2xl mx-auto">
      <span class="px-3 py-1 bg-neon-cyan/20 text-neon-cyan border border-neon-cyan/40 text-xs font-mono font-bold rounded-full uppercase tracking-wider">
        🎯 Instant 1-Click Demolition
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Preset <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan via-neon-pink to-neon-yellow">Target Arenas</span>
      </h1>
      <p class="text-sm sm:text-base text-destruct-muted">
        Select a pre-built arena layout below to immediately start smashing with zero loading delay.
      </p>
    </div>

    <!-- Targets Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {TARGET_SITES.map((target) => (
        <TargetCard target={target} />
      ))}
    </div>

    <!-- Custom URL Banner -->
    <div class="bg-arcade-card border border-arcade-border rounded-3xl p-6 sm:p-8 text-center space-y-4">
      <h3 class="text-xl sm:text-2xl font-black text-white">
        Want to Destroy a Website Not Listed Here?
      </h3>
      <p class="text-xs sm:text-sm text-destruct-muted max-w-md mx-auto">
        Our universal engine can simulate any URL on the internet. Head over to the sandbox and enter your custom address!
      </p>
      <a
        href="/#game-viewport"
        class="inline-block px-6 py-3 bg-neon-pink text-white font-black text-xs rounded-xl shadow-[0_0_20px_rgba(255,42,109,0.4)] hover:scale-105 transition-transform uppercase font-mono"
      >
        🌐 Load Custom Website URL
      </a>
    </div>
  </div>
</Layout>
