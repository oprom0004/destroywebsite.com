---
import Layout from '../layouts/Layout.astro';
import BookmarkletBox from '../components/BookmarkletBox.astro';

const pageTitle = 'Destroy Website Bookmarklet: 1-Click Browser Destruction Tool';
const pageDescription = 'Install the free Destroy Website bookmarklet to smash any live webpage on the internet with a single click. No browser extension or software download required.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Destroy Website Bookmarklet & Webmaster Embed Guide',
    description: 'How to install and run the JavaScript bookmarklet tool to destroy any live website from your bookmarks bar.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://destroywebsite.com/' },
      { '@type': 'ListItem', position: 2, name: 'Bookmarklet', item: 'https://destroywebsite.com/bookmarklet/' },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono text-destruct-dim" aria-label="Breadcrumb">
      <a href="/" class="hover:text-neon-cyan">Home</a>
      <span>/</span>
      <span class="text-white">Bookmarklet & Embed Tool</span>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Universal <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-pink to-neon-yellow">Bookmarklet</span> Tool
      </h1>
      <p class="text-sm sm:text-base text-destruct-muted max-w-xl mx-auto">
        Carry the power of web demolition wherever you browse. Works on Google Chrome, Apple Safari, Mozilla Firefox, and Microsoft Edge.
      </p>
    </div>

    <!-- Main Bookmarklet Box Component -->
    <BookmarkletBox />

    <!-- How It Works Instructions -->
    <div class="bg-arcade-card border border-arcade-border rounded-3xl p-6 sm:p-8 space-y-6 text-sm text-destruct-muted leading-relaxed">
      <h2 class="text-xl font-bold text-white border-b border-arcade-border pb-3 flex items-center gap-2">
        <span>📖</span>
        <span>Detailed Installation Instructions</span>
      </h2>

      <div class="space-y-4">
        <div class="p-4 bg-arcade-darkest rounded-2xl border border-arcade-border space-y-1">
          <h3 class="font-bold text-white text-base">For Desktop (Chrome, Edge, Brave, Opera)</h3>
          <p>
            1. Ensure your Bookmarks Bar is visible by pressing <kbd class="px-1.5 py-0.5 bg-arcade-card rounded text-white">Ctrl + Shift + B</kbd> (Windows) or <kbd class="px-1.5 py-0.5 bg-arcade-card rounded text-white">Cmd + Shift + B</kbd> (Mac).<br />
            2. Click and hold the pink <strong>"💥 DESTROY WEBSITE"</strong> button above, then drag it directly into your bookmarks bar.<br />
            3. Visit any website (e.g. news sites, blogs, documentation) and simply click the bookmark to start smashing!
          </p>
        </div>

        <div class="p-4 bg-arcade-darkest rounded-2xl border border-arcade-border space-y-1">
          <h3 class="font-bold text-white text-base">For Mobile & Safari Users</h3>
          <p>
            1. Bookmark this page in your mobile browser.<br />
            2. Edit the newly created bookmark, rename it to "Destroy Website", and replace the URL with the JavaScript snippet.<br />
            3. Whenever you are on a webpage, type "Destroy Website" in your mobile address bar and tap the bookmark to execute.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
