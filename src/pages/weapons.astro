---
import Layout from '../layouts/Layout.astro';
import WeaponCard from '../components/WeaponCard.astro';
import { WEAPONS } from '../data/weapons';

const pageTitle = 'Destroy Website Weapons: 8 Weapons, Controls & Blast Sizes';
const pageDescription = 'Compare Pistol, Uzi, Shotgun, Gatling, Laser Beam, Rocket, Cannon and Grenade. Learn keys 1–8, blast sizes, firing intervals and how each weapon works.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Destroy Website Weapon Armory',
    description: 'List of all 8 destruction weapons and superweapons in the Destroy Website sandbox.',
    itemListElement: WEAPONS.map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: w.name,
      description: `${w.tagline} - Control: ${w.shortcut}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://destroywebsite.com/' },
      { '@type': 'ListItem', position: 2, name: 'Weapons', item: 'https://destroywebsite.com/weapons/' },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono text-destruct-dim" aria-label="Breadcrumb">
      <a href="/" class="hover:text-neon-cyan">Home</a>
      <span>/</span>
      <span class="text-white">Weapons Arsenal</span>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3 max-w-2xl mx-auto">
      <span class="px-3 py-1 bg-neon-pink/20 text-neon-pink border border-neon-pink/40 text-xs font-mono font-bold rounded-full uppercase tracking-wider">
        💣 8 Demolition Tools Available
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Destruction <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-pink via-neon-yellow to-neon-cyan">Weapon Armory</span>
      </h1>
      <p class="text-sm sm:text-base text-destruct-muted">
        Inspect keyboard shortcuts, blast sizes, and firing mechanics. All weapons are available from the start.
      </p>
    </div>

    <section class="text-sm text-destruct-muted space-y-2">
      <h2 class="text-xl font-bold text-white">Choosing and using weapons</h2>
      <p>Press 1–8 or select a weapon in the dock, then aim and hold the left mouse button to fire. Select Grenade with 8, or throw one with G or right click without switching weapons. A/D and arrow keys move independently of aiming. The mouse wheel browses the webpage.</p>
      <p>All eight weapons are available immediately. Sizes below use game-world pixels; firing intervals are the minimum time between shots. Destruction measures removed webpage area, not enemy damage or DPS.</p>
    </section>
    <!-- Weapons Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {WEAPONS.map((weapon) => (
        <WeaponCard weapon={weapon} />
      ))}
    </div>

    <!-- Tactical Nuke Spotlight Banner -->
    <div class="bg-gradient-to-br from-arcade-card via-arcade-darkest to-arcade-card border-2 border-neon-green/40 rounded-3xl p-6 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-8 shadow-[0_0_40px_rgba(0,245,155,0.15)]">
      <div class="space-y-3 max-w-xl">
        <div class="inline-flex items-center gap-2">
          <span class="px-2.5 py-0.5 bg-neon-green/20 text-neon-green border border-neon-green/50 text-[10px] font-mono font-black rounded uppercase">
            ☢️ Cluster Cannon
          </span>
          <span class="text-xs font-mono text-destruct-dim">Keyboard: 7 · 1.8 second cooldown</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          Cannon
        </h3>
        <p class="text-xs sm:text-sm text-destruct-muted leading-relaxed">
          Fire a heavy projectile at your crosshair. Its first blast triggers five smaller explosions nearby, tearing out webpage fragments and revealing the world behind them.
        </p>
      </div>

      <a
        href="/?target=demo%3Acandy&amp;weapon=nuke#game-viewport"
        class="shrink-0 px-6 py-3.5 bg-neon-green hover:bg-neon-green/80 text-arcade-darkest font-black text-xs sm:text-sm rounded-xl shadow-[0_0_25px_rgba(0,245,155,0.4)] transition-all font-mono uppercase"
      >
        ☢️ Try the Cannon
      </a>
    </div>
  </div>
</Layout>
