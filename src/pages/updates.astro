---
import Layout from '../layouts/Layout.astro';
import { CHANGELOG } from '../data/changelog';

const pageTitle = 'Destroy Website Updates: Patch Notes, New Weapons & Engine Releases';
const pageDescription = 'Check out the latest Destroy Website patch notes, newly added destruction weapons, physics engine performance boosts, and upcoming feature roadmaps.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: 'Destroy Website Release Notes and Changelog',
    description: 'Chronological history of major updates, weapons additions, and physics engine improvements for Destroy Website.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://destroywebsite.com/' },
      { '@type': 'ListItem', position: 2, name: 'Updates', item: 'https://destroywebsite.com/updates/' },
    ],
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={schemas}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono text-destruct-dim" aria-label="Breadcrumb">
      <a href="/" class="hover:text-neon-cyan">Home</a>
      <span>/</span>
      <span class="text-white">Version Updates</span>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3">
      <span class="px-3 py-1 bg-neon-green/20 text-neon-green border border-neon-green/40 text-xs font-mono font-bold rounded-full uppercase tracking-wider">
        🚀 Active Development
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Version <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-green via-neon-cyan to-neon-pink">Changelog & Updates</span>
      </h1>
      <p class="text-sm sm:text-base text-destruct-muted max-w-xl mx-auto">
        Stay up to date with the latest weapon releases, physics optimizations, and new preset targets.
      </p>
    </div>

    <!-- Timeline of Releases -->
    <div class="space-y-6">
      {CHANGELOG.map((item) => (
        <div class="bg-arcade-card border border-arcade-border rounded-3xl p-6 sm:p-8 space-y-4 shadow-lg">
          <div class="flex items-center justify-between flex-wrap gap-2 border-b border-arcade-border pb-3">
            <div class="flex items-center gap-3">
              <span class="text-xl font-black text-white font-mono">{item.version}</span>
              <span class="px-2.5 py-0.5 bg-neon-pink/20 text-neon-pink border border-neon-pink/40 text-[11px] font-mono font-bold rounded">
                {item.badge}
              </span>
            </div>
            <span class="text-xs font-mono text-destruct-dim">{item.date}</span>
          </div>

          <ul class="space-y-2 text-xs sm:text-sm text-destruct-muted">
            {item.highlights.map((h) => (
              <li class="flex items-start gap-2">
                <span class="text-neon-cyan font-bold">▸</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</Layout>
